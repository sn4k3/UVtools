<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tools="clr-namespace:UVtools.UI.Controls.Tools"
             xmlns:operations="clr-namespace:UVtools.Core.Operations;assembly=UVtools.Core"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UVtools.UI.Controls.Tools.ToolPCBExposureControl"
             x:DataType="tools:ToolPCBExposureControl">
    <Grid ColumnDefinitions="Auto,10,350">
        <StackPanel Spacing="10">

            <Border BorderBrush="Gray" BorderThickness="1" Padding="5"
                    DragDrop.AllowDrop="True">
                <Grid>
                    <StackPanel Spacing="5" Orientation="Vertical">
                        <StackPanel Spacing="5" Orientation="Horizontal">
                            <Button Command="{Binding AddFiles}"
                                    Content="{icon:MaterialIconTextExt Kind=Plus, Text='Add'}" />

                            <Button Command="{Binding AddFilesFromZip}"
                                    Content="{icon:MaterialIconTextExt Kind=ZipBox, Text='Add'}" />

                            <Button IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Command="{Binding RemoveFiles}"
                                    Content="{icon:MaterialIconTextExt Kind=Minus, Text='Remove'}" />
                        </StackPanel>

                        <StackPanel Spacing="2" Orientation="Horizontal">
                            <Button IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Command="{Binding MoveFileTop}"
                                    Content="{icon:MaterialIconExt Kind=ChevronDoubleUp}"
                                    ToolTip.Tip="Move gerber to top" />

                            <Button IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Command="{Binding MoveFileUp}"
                                    Content="{icon:MaterialIconExt Kind=ChevronUp}"
                                    ToolTip.Tip="Move gerber up" />

                            <Button IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Command="{Binding MoveFileDown}"
                                    Content="{icon:MaterialIconExt Kind=ChevronDown}"
                                    ToolTip.Tip="Move gerber down" />

                            <Button IsEnabled="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Command="{Binding MoveFileBottom}"
                                    Content="{icon:MaterialIconExt Kind=ChevronDoubleDown}"
                                    ToolTip.Tip="Move gerber to bottom" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Spacing="5" Orientation="Vertical">
                        <StackPanel HorizontalAlignment="Right" Spacing="5" Orientation="Horizontal">
                            <Button IsEnabled="{Binding Operation.Files.Count}"
                                    Command="{Binding ClearFiles}"
                                    Content="{icon:MaterialIconTextExt Kind=DeleteSweep, Text={Binding Operation.Files.Count, StringFormat=Clear {0} files}}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Spacing="5" Orientation="Horizontal">
                            <Button IsEnabled="{Binding Operation.Files.Count}"
                                    Command="{Binding Operation.Sort}"
                                    Content="{icon:MaterialIconTextExt Kind=SortAlphabeticalAscending, Text='Sort ASC'}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid Name="FilesDataGrid"
                      BorderBrush="Gray" BorderThickness="1"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="False"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Extended"
                      ClipboardCopyMode="IncludeHeader"
                      MinHeight="150"
                      MaxHeight="400"
                      Width="508"
                      ItemsSource="{Binding Operation.Files}"
                      SelectedItem="{Binding SelectedFile}"
                      DragDrop.AllowDrop="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Filename"
                                        Binding="{Binding FileName}"
                                        IsReadOnly="True"
                                        Width="*" />
                    <DataGridTemplateColumn Header="Size scale"
                                            Width="130">
                        <DataTemplate x:DataType="operations:OperationPCBExposure+PCBExposureFile">
                            <NumericUpDown Increment="0.05"
                                           Minimum="0.01"
                                           Maximum="100"
                                           FormatString="F2"
                                           Value="{Binding SizeScale}" />
                        </DataTemplate>
                    </DataGridTemplateColumn>

                    <DataGridCheckBoxColumn Header="Invert"
                                            Binding="{Binding InvertPolarity}"
                                            Width="Auto" />
                    <DataGridCheckBoxColumn Header="Outline"
                                            Binding="{Binding IsBoardOutline}"
                                            Width="Auto" />
                </DataGrid.Columns>

            </DataGrid>


            <Grid RowDefinitions="Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto"
                  ColumnDefinitions="Auto,10,400">

                <ToggleSwitch Grid.Row="0" Grid.Column="2"
                              IsChecked="{Binding Operation.MergeFiles}"
                              OnContent="Draw all gerber files into same layer"
                              OffContent="Create one layer per gerber file" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Layer height:" />
                <NumericUpDown Grid.Row="2" Grid.Column="2"
                               suki:NumericUpDownExtensions.Unit="mm"
                               Increment="0.01"
                               Minimum="0.001"
                               Maximum="500"
                               FormatString="F3"
                               Value="{Binding Operation.LayerHeight}" />


                <TextBlock Grid.Row="4" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Exposure time:" />
                <NumericUpDown Grid.Row="4" Grid.Column="2"
                               suki:NumericUpDownExtensions.Unit="s"
                               Increment="0.5"
                               Minimum="0.5"
                               Maximum="1000"
                               FormatString="F2"
                               Value="{Binding Operation.ExposureTime}" />

                <TextBlock Grid.Row="6" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Size rounding:" />

                <ComboBox Grid.Row="6" Grid.Column="2"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Operation.SizeMidpointRounding, Converter={StaticResource EnumToCollectionConverter}, Mode=OneTime}"
                          SelectedItem="{Binding Operation.SizeMidpointRounding, Converter={StaticResource FromValueDescriptionToEnumConverter}}" />


                <TextBlock Grid.Row="8" Grid.Column="0"
                           VerticalAlignment="Center"
                           ToolTip.Tip="Offset the PCB origin.
&#x0a;Applied on top of the selected placement, use it to nudge the artwork from there.
&#x0a;Use the 'Show full preview image (The final result)' option to preview the resulting position."
                           Text="Offset X/Y:" />

                <StackPanel Grid.Row="8" Grid.Column="2"
                            Orientation="Horizontal" Spacing="20">
                    <NumericUpDown suki:NumericUpDownExtensions.Unit="mm"
                                   Increment="0.05"
                                   Minimum="-10000"
                                   Maximum="10000"
                                   FormatString="F2"
                                   Width="187"
                                   Value="{Binding Operation.OffsetX}" />

                    <NumericUpDown suki:NumericUpDownExtensions.Unit="mm"
                                   Increment="0.05"
                                   Minimum="-10000"
                                   Maximum="10000"
                                   FormatString="F2"
                                   Width="187"
                                   Value="{Binding Operation.OffsetY}" />
                </StackPanel>

                <TextBlock Grid.Row="10" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Positioning:" />

                <Grid Grid.Row="10" Grid.Column="2"
                      ColumnDefinitions="90,20,*"
                      MinHeight="90"
                      ToolTip.Tip="Place the artwork at the selected side of the plate before drawing it.
&#x0a;Files exported with absolute page coordinates, such as most KiCad plots, sit far from the origin and would otherwise fall outside the plate and render blank.">
                    <Grid Grid.Column="0"
                          RowDefinitions="30,30,30"
                          ColumnDefinitions="30,30,30"
                          Width="90"
                          Height="90">
                        <RadioButton Grid.Row="0" Grid.Column="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     GroupName="Anchor"
                                     ToolTip.Tip="Top Left"
                                     IsChecked="{Binding Operation.Anchor, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=TopLeft, Mode=OneWay}"
                                     Command="{Binding Operation.SetAnchor}"
                                     CommandParameter="0" />
                        <RadioButton Grid.Row="0" Grid.Column="1"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     GroupName="Anchor"
                                     ToolTip.Tip="Top Center"
                                     IsChecked="{Binding Operation.Anchor, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=TopCenter, Mode=OneWay}"
                                     Command="{Binding Operation.SetAnchor}"
                                     CommandParameter="1" />
                        <RadioButton Grid.Row="0" Grid.Column="2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     GroupName="Anchor"
                                     ToolTip.Tip="Top Right"
                                     IsChecked="{Binding Operation.Anchor, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=TopRight, Mode=OneWay}"
                                     Command="{Binding Operation.SetAnchor}"
                                     CommandParameter="2" />

                        <RadioButton Grid.Row="1" Grid.Column="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     GroupName="Anchor"
                                     ToolTip.Tip="Middle Left"
                                     IsChecked="{Binding Operation.Anchor, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=MiddleLeft, Mode=OneWay}"
                                     Command="{Binding Operation.SetAnchor}"
                                     CommandParameter="3" />
                        <RadioButton Grid.Row="1" Grid.Column="1"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     GroupName="Anchor"
                                     ToolTip.Tip="Middle Center"
                                     IsChecked="{Binding Operation.Anchor, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=MiddleCenter, Mode=OneWay}"
                                     Command="{Binding Operation.SetAnchor}"
                                     CommandParameter="4" />
                        <RadioButton Grid.Row="1" Grid.Column="2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     GroupName="Anchor"
                                     ToolTip.Tip="Middle Right"
                                     IsChecked="{Binding Operation.Anchor, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=MiddleRight, Mode=OneWay}"
                                     Command="{Binding Operation.SetAnchor}"
                                     CommandParameter="5" />

                        <RadioButton Grid.Row="2" Grid.Column="0"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     GroupName="Anchor"
                                     ToolTip.Tip="Bottom Left"
                                     IsChecked="{Binding Operation.Anchor, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BottomLeft, Mode=OneWay}"
                                     Command="{Binding Operation.SetAnchor}"
                                     CommandParameter="6" />
                        <RadioButton Grid.Row="2" Grid.Column="1"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     GroupName="Anchor"
                                     ToolTip.Tip="Bottom Center"
                                     IsChecked="{Binding Operation.Anchor, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BottomCenter, Mode=OneWay}"
                                     Command="{Binding Operation.SetAnchor}"
                                     CommandParameter="7" />
                        <RadioButton Grid.Row="2" Grid.Column="2"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     GroupName="Anchor"
                                     ToolTip.Tip="Bottom Right"
                                     IsChecked="{Binding Operation.Anchor, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BottomRight, Mode=OneWay}"
                                     Command="{Binding Operation.SetAnchor}"
                                     CommandParameter="8" />
                    </Grid>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <RadioButton GroupName="Anchor"
                                     Content="Original from board"
                                     ToolTip.Tip="Preserve the exact coordinates declared by the board files."
                                     IsChecked="{Binding Operation.Anchor, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=None, Mode=OneWay}"
                                     Command="{Binding Operation.SetAnchor}"
                                     CommandParameter="9" />

                        <CheckBox VerticalAlignment="Center"
                                  IsChecked="{Binding Operation.FlipVertically}"
                                  ToolTip.Tip="Flip the artwork along the vertical axis.
&#x0a;Gerber and drill files put the origin at the bottom left with Y growing upwards, while image rows grow downwards, so the drawing comes out mirrored top to bottom without this.
&#x0a;Leave it enabled to get the same orientation your CAD tool or gerber viewer shows."
                                  Content="Flip vertically" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="12" Grid.Column="0"
                           VerticalAlignment="Center"
                           ToolTip.Tip="Repeat the artwork as many times as it fits to fill the plate.
&#x0a;Only whole copies are placed, a copy that would be clipped by the plate edge is skipped.
&#x0a;The spacing is the gap left between the copies."
                           Text="Fill plate:" />

                <StackPanel Grid.Row="12" Grid.Column="2"
                            Orientation="Horizontal" Spacing="20">
                    <CheckBox VerticalAlignment="Center"
                              IsChecked="{Binding Operation.FillPlate}"
                              Content="Enable" />

                    <NumericUpDown suki:NumericUpDownExtensions.Unit="mm"
                                   Increment="0.5"
                                   Minimum="0"
                                   Maximum="1000"
                                   FormatString="F2"
                                   Width="140"
                                   IsEnabled="{Binding Operation.FillPlate}"
                                   ToolTip.Tip="Horizontal gap between copies"
                                   Value="{Binding Operation.FillSpacingX}" />

                    <NumericUpDown suki:NumericUpDownExtensions.Unit="mm"
                                   Increment="0.5"
                                   Minimum="0"
                                   Maximum="1000"
                                   FormatString="F2"
                                   Width="140"
                                   IsEnabled="{Binding Operation.FillPlate}"
                                   ToolTip.Tip="Vertical gap between copies"
                                   Value="{Binding Operation.FillSpacingY}" />
                </StackPanel>

                <TextBlock Grid.Row="14" Grid.Column="0"
                           VerticalAlignment="Center"
                           ToolTip.Tip="The area the 'Invert color' option covers.
&#x0a;Inverting lights the background and masks the traces, so this decides how much of the plate is exposed."
                           Text="Invert area:" />

                <Grid Grid.Row="14" Grid.Column="2" ColumnSpacing="10"
                      ColumnDefinitions="Auto,*">
                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                              IsChecked="{Binding Operation.InvertColor}"
                              Content="Enable" />

                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              IsEnabled="{Binding Operation.InvertColor}"
                              ItemsSource="{Binding Operation.InvertArea, Converter={StaticResource EnumToCollectionConverter}, Mode=OneTime}"
                              SelectedItem="{Binding Operation.InvertArea, Converter={StaticResource FromValueDescriptionToEnumConverter}}" />
                </Grid>


                <TextBlock Grid.Row="16" Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Options:" />

                <StackPanel Grid.Row="16" Grid.Column="2"
                            Orientation="Horizontal" Spacing="20">
                    <CheckBox VerticalAlignment="Center"
                              IsChecked="{Binding Operation.Mirror}"
                              Content="Mirror" />


                    <CheckBox VerticalAlignment="Center"
                              IsChecked="{Binding Operation.EnableAntiAliasing}"
                              Content="Enable Anti-Aliasing" />
                </StackPanel>
            </Grid>

        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="10">
            <ToggleSwitch IsChecked="{Binding CropPreview}"
                          OnContent="Show preview image cropped by it bounds"
                          OffContent="Show full preview image (The final result)" />

            <Image Stretch="Uniform"
                   MaxHeight="700"
                   Source="{Binding PreviewImage}" />

            <TextBlock Text="{Binding PreviewImage.Size, StringFormat=Size: {0}}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>