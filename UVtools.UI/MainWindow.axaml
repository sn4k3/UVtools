<windows:GenericWindow x:Class="UVtools.UI.MainWindow"
                       xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:core="clr-namespace:UVtools.Core;assembly=UVtools.Core"
                       xmlns:controls="clr-namespace:UVtools.UI.Controls"
                       xmlns:layers="clr-namespace:UVtools.Core.Layers;assembly=UVtools.Core"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:fragments="clr-namespace:UVtools.UI.Controls.Fragments"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:ui="clr-namespace:UVtools.UI"
                       xmlns:suki="https://github.com/kikipoulet/SukiUI"
                       xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                       xmlns:windows="clr-namespace:UVtools.UI.Windows"
                       xmlns:uvtava="clr-namespace:UVtools.AvaloniaControls;assembly=UVtools.AvaloniaControls"
                       Title="UVtools"
                       MinWidth="1024"
                       MinHeight="600"
                       CanFullScreen="True"
                       CanPin="True"
                       IsMenuVisible="True"
                       d:DesignHeight="600"
                       d:DesignWidth="1024"
                       x:DataType="ui:MainWindow"
                       DragDrop.AllowDrop="True"
                       Icon="/Assets/Icons/UVtools.ico"
                       mc:Ignorable="d">
    <windows:GenericWindow.KeyBindings>
        <KeyBinding Command="{Binding GoToLayerPreviewTabCommand}"
                    Gesture="{OnPlatform Ctrl+D1,
					macOS=⌘+D1}" />
        <KeyBinding Command="{Binding GoToLayerPreviewTabCommand}"
                    Gesture="{OnPlatform Ctrl+NumPad1,
					macOS=⌘+NumPad1}" />
        <KeyBinding Command="{Binding GoTo3DLayerPreviewTabCommand}"
                    Gesture="{OnPlatform Ctrl+D2,
					macOS=⌘+D2}" />
        <KeyBinding Command="{Binding GoTo3DLayerPreviewTabCommand}"
                    Gesture="{OnPlatform Ctrl+NumPad2,
					macOS=⌘+NumPad2}" />
        <KeyBinding Command="{Binding GoToDualPreviewTabCommand}"
                    Gesture="{OnPlatform Ctrl+D3,
					macOS=⌘+D3}" />
        <KeyBinding Command="{Binding GoToDualPreviewTabCommand}"
                    Gesture="{OnPlatform Ctrl+NumPad3,
					macOS=⌘+NumPad3}" />
        <KeyBinding Command="{Binding MenuFileOpenClickedCommand}"
                    Gesture="{OnPlatform Ctrl+O,
					macOS=⌘+O}" />
        <KeyBinding Command="{Binding MenuFileOpenNewWindowClickedCommand}"
                    Gesture="{OnPlatform Ctrl+Shift+O,
					macOS=⌘+Shift+O}" />
        <KeyBinding Command="{Binding ReloadFileCommand}"
                    Gesture="{OnPlatform Ctrl+F5,
					macOS=⌘+F5}" />
        <KeyBinding Command="{Binding MenuFileRenameClickedCommand}"
                    Gesture="{OnPlatform Ctrl+F2,
					macOS=⌘+F2}" />
        <KeyBinding Command="{Binding MenuFileSaveClickedCommand}"
                    Gesture="{OnPlatform Ctrl+S,
					macOS=⌘+S}" />
        <KeyBinding Command="{Binding MenuFileSaveAsClickedCommand}"
                    Gesture="{OnPlatform Ctrl+Shift+S,
					macOS=⌘+Shift+S}" />
        <KeyBinding Command="{Binding MenuFileCloseFileClickedCommand}"
                    Gesture="{OnPlatform Ctrl+W,
					macOS=⌘+W}" />
        <KeyBinding Command="{Binding IPrintedThisFileCommand}"
                    Gesture="{OnPlatform Ctrl+P,
					macOS=⌘+P}" />
        <KeyBinding Command="{Binding MenuFileOpenContainingFolderClickedCommand}"
                    Gesture="{OnPlatform Ctrl+Shift+L,
					macOS=⌘+Shift+L}" />
        <KeyBinding Command="{Binding ExtractFileCommand}"
                    Gesture="{OnPlatform Ctrl+Shift+E,
					macOS=⌘+Shift+E}" />
        <KeyBinding Command="{Binding OpenTerminalCommand}"
                    Gesture="{OnPlatform Ctrl+Shift+T,
					macOS=⌘+Shift+T}" />
        <KeyBinding Command="{Binding MenuFileFullscreenClickedCommand}"
                    Gesture="F11" />
        <KeyBinding Command="{Binding MenuFileSettingsClickedCommand}"
                    Gesture="{OnPlatform 'Ctrl+,', macOS='⌘+,'}" />

        <KeyBinding Command="{Binding MenuHelpAboutClickedCommand}"
                    Gesture="F1" />
        <KeyBinding Command="{Binding OpenWebsiteCommand}"
                    CommandParameter="{Binding Source={x:Static core:About.Website}}"
                    Gesture="{OnPlatform Ctrl+F1, macOS=⌘+F1}" />
        <KeyBinding Command="{Binding MenuHelpMaterialManagerClickedCommand}"
                    Gesture="F10" />
        <KeyBinding Command="{Binding MenuHelpMaterialManagerClickedCommand}"
                    Gesture="F10" />
    </windows:GenericWindow.KeyBindings>

    <windows:GenericWindow.MenuItems>
        <MenuItem Name="MainMenuFile" Header="_File">
            <MenuItem Name="MainMenuFileOpen"
                      Icon="{icon:MaterialIconExt Kind=FileImport}"
                      Command="{Binding MenuFileOpenClickedCommand}"
                      Header="_Open"
                      HotKey="{OnPlatform Ctrl+O, macOS=⌘+O}"
                      InputGesture="{Binding $self.HotKey}" />

            <MenuItem Name="MainMenuFileOpenNewWindow"
                      Icon="{icon:MaterialIconExt Kind=FileMultiple}"
                      Command="{Binding MenuFileOpenNewWindowClickedCommand}"
                      Header="_Open in new window"
                      HotKey="{OnPlatform Ctrl+Shift+O,
					  macOS=⌘+Shift+O}"
                      InputGesture="{Binding $self.HotKey}" />

            <MenuItem Name="MainMenuFileOpenRecent"
                      Icon="{icon:MaterialIconExt Kind=FileTable}"
                      Header="_Open recent"
                      ItemsSource="{Binding MenuFileOpenRecentItems}"
                      ToolTip.ShowDelay="2000"
                      ToolTip.Tip="On a file: &#x0a;Shift + Click: Open file in a new window &#x0a;Shift + Ctrl + Click: Remove file from list &#x0a;Ctrl + Click: Purge non-existing files" />

            <MenuItem Name="MainMenuFileOpenInPartialMode"
                      Icon="{icon:MaterialIconExt Kind=FileImportOutline}"
                      Command="{Binding MenuFileOpenInPartialModeClickedCommand}"
                      Header="_Open in partial mode"
                      ToolTip.Tip="Open a file only to see and/or edit properties. &#x0a;Layer images won't be loaded and most tools won't run in this mode." />

            <MenuItem Name="MainMenuFileReload"
                      Icon="{icon:MaterialIconExt Kind=FileRefresh}"
                      Command="{Binding ReloadFileCommand}"
                      Header="_Reload"
                      HotKey="{OnPlatform Ctrl+F5,
					  macOS=⌘+F5}"
                      InputGesture="{Binding $self.HotKey}"
                      IsEnabled="{Binding IsFileLoaded}" />

            <MenuItem Name="MainMenuFileSave"
                      Icon="{icon:MaterialIconExt Kind=ContentSave}"
                      Command="{Binding MenuFileSaveClickedCommand}"
                      Header="_Save"
                      HotKey="{OnPlatform Ctrl+S,
					  macOS=⌘+S}"
                      InputGesture="{Binding $self.HotKey}"
                      IsEnabled="{Binding CanSave}" />

            <MenuItem Name="MainMenuFileSaveAs"
                      Icon="{icon:MaterialIconExt Kind=ContentSaveCheck}"
                      Command="{Binding MenuFileSaveAsClickedCommand}"
                      Header="_Save as"
                      HotKey="{OnPlatform Ctrl+Shift+S,
					  macOS=⌘+Shift+S}"
                      InputGesture="{Binding $self.HotKey}"
                      IsEnabled="{Binding IsFileLoaded}" />

            <MenuItem Name="MainMenuFileRename"
                      Icon="{icon:MaterialIconExt Kind=Rename}"
                      Command="{Binding MenuFileRenameClickedCommand}"
                      Header="_Rename"
                      HotKey="{OnPlatform Ctrl+F2,
					  macOS=⌘+F2}"
                      InputGesture="{Binding $self.HotKey}"
                      IsEnabled="{Binding IsFileLoaded}" />

            <MenuItem Name="MainMenuFileConvert"
                      Icon="{icon:MaterialIconExt Kind=Exchange}"
                      Header="_Convert to"
                      IsEnabled="{Binding IsFileLoaded}"
                      IsVisible="{Binding MenuFileConvertItems, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ItemsSource="{Binding MenuFileConvertItems}" />

            <MenuItem Name="MainMenuFileSendTo"
                      Icon="{icon:MaterialIconExt Kind=Share}"
                      Header="_Send to"
                      IsEnabled="{Binding IsFileLoaded}"
                      ItemsSource="{Binding MenuFileSendToItems}" />

            <MenuItem Name="MainMenuFileClose"
                      Icon="{icon:MaterialIconExt Kind=FileRemove}"
                      Command="{Binding MenuFileCloseFileClickedCommand}"
                      Header="_Close"
                      HotKey="{OnPlatform Ctrl+W,
					  macOS=⌘+W}"
                      InputGesture="{Binding $self.HotKey}"
                      IsEnabled="{Binding IsFileLoaded}" />

            <Separator />

            <MenuItem Icon="{icon:MaterialIconExt Kind=Hammer}"
                      Command="{Binding ResetLayersPropertiesCommand}"
                      Header="_Reset layers properties"
                      ToolTip.Tip="Reset all layer properties with the file globals. &#x0a;Hold SHIFT key to also rebuild layers position with the file layer height.">
                <MenuItem.IsEnabled>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsFileLoaded" />
                        <Binding Path="SlicerFile.SupportPerLayerSettings" />
                    </MultiBinding>
                </MenuItem.IsEnabled>
            </MenuItem>

            <MenuItem Icon="{icon:MaterialIconExt Kind=Flask}"
                      Command="{Binding IPrintedThisFileCommand}"
                      Header="_I printed this file"
                      HotKey="{OnPlatform Ctrl+P,
					  macOS=⌘+P}"
                      InputGesture="{Binding $self.HotKey}"
                      IsEnabled="{Binding IsFileLoaded}" />

            <MenuItem Name="MainMenuFileOpenContainingFileFolder"
                      Icon="{icon:MaterialIconExt Kind=FolderOpen}"
                      Command="{Binding MenuFileOpenContainingFolderClickedCommand}"
                      Header="_Open containing folder"
                      HotKey="{OnPlatform Ctrl+Shift+L,
					  macOS=⌘+Shift+L}"
                      InputGesture="{Binding $self.HotKey}"
                      IsEnabled="{Binding IsFileLoaded}" />

            <MenuItem Name="MainMenuFileExtract"
                      Icon="{icon:MaterialIconExt Kind=FolderZip}"
                      Command="{Binding ExtractFileCommand}"
                      Header="_Extract file contents"
                      HotKey="{OnPlatform Ctrl+Shift+E,
					  macOS=⌘+Shift+E}"
                      InputGesture="{Binding $self.HotKey}"
                      IsEnabled="{Binding IsFileLoaded}" />

            <MenuItem Icon="{icon:MaterialIconExt Kind=FileExport}"
                      Command="{Binding CopyParametersToFilesCommand}"
                      Header="_Copy parameters to files"
                      IsEnabled="{Binding IsFileLoaded}" />

            <MenuItem Name="MainMenuFileTerminal"
                      Icon="{icon:MaterialIconExt Kind=Terminal}"
                      Command="{Binding OpenTerminalCommand}"
                      Header="_Terminal"
                      HotKey="{OnPlatform Ctrl+Shift+T,
					  macOS=⌘+Shift+T}"
                      InputGesture="{Binding $self.HotKey}"
                      IsEnabled="{Binding IsFileLoaded}" />

            <Separator />

            <MenuItem Name="MainMenuFileFullscreen"
                      Icon="{icon:MaterialIconExt Kind=Fullscreen}"
                      Command="{Binding MenuFileFullscreenClickedCommand}"
                      Header="_Fullscreen"
                      HotKey="F11"
                      InputGesture="{Binding $self.HotKey}" />

            <MenuItem Name="MainMenuFileSettings"
                      Icon="{icon:MaterialIconExt Kind=Cog}"
                      Command="{Binding MenuFileSettingsClickedCommand}"
                      Header="_Settings"
                      HotKey="Ctrl+,"
                      InputGesture="{Binding $self.HotKey}" />

            <Separator />

            <MenuItem Name="MainMenuFileExit"
                      Icon="{icon:MaterialIconExt Kind=SignOut}"
                      Command="{Binding CloseWindowCommand}"
                      Header="_Exit"
                      InputGesture="Alt+F4" />
        </MenuItem>

        <MenuItem Header="_Tools"
                  IsEnabled="{Binding IsFileLoaded}"
                  IsVisible="{Binding IsFileLoaded}"
                  ItemsSource="{Binding MenuTools}" />

        <MenuItem Header="_Calibration"
                  IsEnabled="{Binding IsFileLoaded}"
                  IsVisible="{Binding IsFileLoaded}"
                  ItemsSource="{Binding MenuCalibration}" />


        <MenuItem Header="_Help">
            <MenuItem Icon="{icon:MaterialIconExt Kind=InfoCircle}"
                      Command="{Binding MenuHelpAboutClickedCommand}"
                      Header="_About"
                      HotKey="F1"
                      InputGesture="{Binding $self.HotKey}" />

            <MenuItem Icon="{icon:MaterialIconExt Kind=MicrosoftEdge}"
                      Command="{Binding OpenWebsiteCommand}"
                      CommandParameter="{Binding Source={x:Static core:About.Website}}"
                      Header="_Website"
                      HotKey="{OnPlatform Ctrl+F1,
					  macOS=⌘+F1}"
                      InputGesture="{Binding $self.HotKey}" />

            <MenuItem Icon="{icon:MaterialIconExt Kind=Wikipedia}"
                      Command="{Binding OpenWebsiteCommand}"
                      CommandParameter="https://github.com/sn4k3/UVtools/wiki"
                      Header="_Wiki &amp; tutorials" />

            <MenuItem Icon="{icon:MaterialIconExt Kind=Forum}"
                      Header="_Community forums">
                <MenuItem Icon="{icon:MaterialIconExt Kind=Github}"
                          Command="{Binding OpenWebsiteCommand}"
                          CommandParameter="https://github.com/sn4k3/UVtools/discussions"
                          Header="_GitHub" />

                <MenuItem Icon="{icon:MaterialIconExt Kind=Facebook}"
                          Command="{Binding OpenWebsiteCommand}"
                          CommandParameter="https://www.facebook.com/groups/uvtools"
                          Header="_Facebook" />

                <MenuItem Icon="{icon:MaterialIconExt Kind=Reddit}"
                          Command="{Binding OpenWebsiteCommand}"
                          CommandParameter="https://www.reddit.com/search/?q=UVtools&amp;type=link&amp;sort=new"
                          Header="_Reddit" />

                <MenuItem Icon="{icon:MaterialIconExt Kind=Twitter}"
                          Command="{Binding OpenWebsiteCommand}"
                          CommandParameter="https://twitter.com/search?q=UVtools&amp;src=typedquery&amp;f=live"
                          Header="_Twitter" />

                <MenuItem Icon="{icon:MaterialIconExt Kind=Youtube}"
                          Command="{Binding OpenWebsiteCommand}"
                          CommandParameter="https://www.youtube.com/results?search_query=UVtools"
                          Header="_Youtube" />
            </MenuItem>

            <MenuItem Icon="{icon:MaterialIconExt Kind=Donate}"
                      Header="_Donate">

                <MenuItem Icon="{icon:MaterialIconExt Kind=Github}"
                          Command="{Binding OpenWebsiteCommand}"
                          CommandParameter="{Binding Source={x:Static core:About.DonateGitHubUrl}}"
                          Header="_GitHub" />

                <MenuItem Icon="{icon:MaterialIconExt Kind=Payment}"
                          Command="{Binding OpenWebsiteCommand}"
                          CommandParameter="{Binding Source={x:Static core:About.DonatePayPalUrl}}"
                          Header="_PayPal" />

            </MenuItem>


            <Separator />

            <MenuItem Icon="{icon:MaterialIconExt Kind=Flask}"
                      Command="{Binding MenuHelpMaterialManagerClickedCommand}"
                      Header="_Material manager"
                      HotKey="F10"
                      InputGesture="{Binding $self.HotKey}" />

            <MenuItem Icon="{icon:MaterialIconExt Kind=Printer3d}"
                      Command="{Binding MenuHelpInstallProfilesClickedCommand}"
                      Header="_Install profiles into PrusaSlicer" />

            <Separator />

            <MenuItem Icon="{icon:MaterialIconExt Kind=Bug}"
                      Command="{Binding MenuHelpReportIssueClickedCommand}"
                      Header="_Report an issue" />

            <MenuItem Icon="{icon:MaterialIconExt Kind=Help}"
                      Command="{Binding OpenWebsiteCommand}"
                      CommandParameter="https://github.com/sn4k3/UVtools/discussions/categories/q-a"
                      Header="_Ask a question" />

            <MenuItem Icon="{icon:MaterialIconExt Kind=HeadLightbulb}"
                      Command="{Binding OpenWebsiteCommand}"
                      CommandParameter="https://github.com/sn4k3/UVtools/discussions/categories/ideas"
                      Header="_Suggest an improvement or new features" />

            <Separator />

            <MenuItem Icon="{icon:MaterialIconExt Kind=FolderOpen}"
                      Command="{Binding MenuHelpOpenSettingsFolderClickedCommand}"
                      Header="_Open settings folder" />

            <MenuItem Icon="{icon:MaterialIconExt Kind=MemoryArrowDown}"
                      Command="{Binding MenuHelpFreeUnusedRAMClickedCommand}"
                      Header="_Free unused RAM"
                      ToolTip.Tip="Force the garbage collection of all unused objects within the program to free unused memory (RAM). &#x0a;It's never required for the end user run this. The program will automatically take care of it when required. &#x0a;This function is for debug purposes." />

            <MenuItem Icon="{icon:MaterialIconExt Kind=Cpu64Bit}"
                      Command="{Binding MenuHelpBenchmarkClickedCommand}"
                      Header="_Benchmark" />

            <MenuItem Icon="{icon:MaterialIconExt Kind=Ladybug}"
                      Header="_Debug tools"
                      IsVisible="{Binding IsDebug}">

                <MenuItem Icon="{icon:MaterialIconExt Kind=FolderOpen}"
                          Command="{Binding MenuHelpDebugOpenExecutableDirectoryClickedCommand}"
                          Header="_Open executable directory"
                          IsVisible="{Binding IsDebug}" />

                <MenuItem Icon="{icon:MaterialIconExt Kind=LightningBolt}"
                          Command="{Binding MenuHelpDebugThrowExceptionClickedCommand}"
                          Header="_Throw exception"
                          IsVisible="{Binding IsDebug}" />

                <MenuItem Icon="{icon:MaterialIconExt Kind=Message}"
                          Command="{Binding MenuHelpDebugLongMessageBoxClickedCommand}"
                          Header="_Show long message box"
                          IsVisible="{Binding IsDebug}" />

                <MenuItem Icon="{icon:MaterialIconExt Kind=PartyPopper}"
                          Command="{Binding ShowBirthdayMessageCommand}"
                          Header="_Show birthday message box"
                          IsVisible="{Binding IsDebug}" />

                <MenuItem Icon="{icon:MaterialIconExt Kind=CloudDownload}"
                          Command="{Binding MenuHelpDebugTriggerNewUpdateClickedCommand}"
                          Header="_Trigger new update"
                          IsEnabled="{Binding !AppUpdater.IsBusy}"
                          IsVisible="{Binding IsDebug}" />

            </MenuItem>

        </MenuItem>

        <MenuItem Margin="10,0,0,0"
                  Background="DarkGreen"
                  Command="{Binding MenuNewVersionClickedCommand}"
                  CornerRadius="10"
                  Foreground="White"
                  Header="{Binding AppUpdater.LatestReleaseTagVersionStr, StringFormat='New version v{0} is available!'}"
                  IsVisible="{Binding AppUpdater.IsUpdateAvailable}" />

        <MenuItem Margin="10,0,0,0"
                  Background="{StaticResource LogoColor}"
                  Command="{Binding ShowBirthdayMessageCommand}"
                  CornerRadius="10"
                  Foreground="White"
                  Header="{Binding Source={x:Static core:About.BirthdayTitle}}"
                  IsVisible="{Binding Source={x:Static core:About.IsBirthdayWithin7Days}}" />

    </windows:GenericWindow.MenuItems>


    <Grid ColumnDefinitions="*"
          RowDefinitions="*">
        <DockPanel Grid.Row="0"
                   Grid.Column="0"
                   IsEnabled="{Binding IsGUIEnabled}">
            <Border Padding="5"
                    DockPanel.Dock="Bottom"
                    IsVisible="{Binding IsFileLoaded}">
                <WrapPanel VerticalAlignment="Center"
                           Orientation="Horizontal">
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Layers: {0} @ {1}mm">
                                <Binding Path="SlicerFile.LayerCount" />
                                <Binding Path="SlicerFile.LayerHeight" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>


                    <TextBlock IsVisible="{Binding SlicerFile.CanUseBottomLayerCount}"
                               Text="  |  " />
                    <TextBlock IsVisible="{Binding SlicerFile.CanUseBottomLayerCount}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Bottom layers: {0}/{1}mm">
                                <Binding Path="SlicerFile.BottomLayerCount" />
                                <Binding Path="SlicerFile.BottomLayersHeight" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock IsVisible="{Binding SlicerFile.CanUseTransitionLayerCount}"
                               Text="  |  " />
                    <TextBlock IsVisible="{Binding SlicerFile.CanUseTransitionLayerCount}"
                               Text="{Binding SlicerFile.TransitionLayersRepresentation, StringFormat=Transition layers: {0}}" />


                    <TextBlock IsVisible="{Binding SlicerFile.CanUseAnyExposureTime}"
                               Text="  |  " />
                    <TextBlock IsVisible="{Binding SlicerFile.CanUseAnyExposureTime}"
                               Text="{Binding SlicerFile.ExposureRepresentation, StringFormat=Exposure: {0}}" />

                    <TextBlock IsVisible="{Binding SlicerFile.CanUseAnyLiftHeight}"
                               Text="  |  " />
                    <TextBlock IsVisible="{Binding SlicerFile.CanUseAnyLiftHeight}"
                               Text="{Binding SlicerFile.LiftRepresentation, StringFormat=Lift: {0}}" />


                    <TextBlock IsVisible="{Binding SlicerFile.CanUseRetractSpeed}"
                               Text="  |  " />
                    <TextBlock IsVisible="{Binding SlicerFile.CanUseRetractSpeed}"
                               Text="{Binding SlicerFile.RetractRepresentation, StringFormat=Retract: {0}}" />

                    <TextBlock IsVisible="{Binding SlicerFile.CanUseAnyLightOffDelay}"
                               Text="  |  " />
                    <TextBlock IsVisible="{Binding SlicerFile.CanUseAnyLightOffDelay}"
                               Text="{Binding SlicerFile.LightOffDelayRepresentation, StringFormat=Light-off: {0}}" />

                    <TextBlock IsVisible="{Binding SlicerFile.CanUseAnyWaitTime}"
                               Text="  |  " />
                    <TextBlock IsVisible="{Binding SlicerFile.CanUseAnyWaitTime}"
                               Text="{Binding SlicerFile.WaitTimeRepresentation, StringFormat=Wait time: {0}}"
                               ToolTip.Placement="Top"
                               ToolTip.Tip="Wait time: Before cure / After cure / After lift" />

                    <TextBlock IsVisible="{Binding SlicerFile.PrintTimeHours}"
                               Text="  |  " />
                    <TextBlock IsVisible="{Binding SlicerFile.PrintTimeHours}"
                               Text="{Binding SlicerFile.PrintTimeString, StringFormat=Print time: {0}}"
                               ToolTip.Placement="Top">
                        <ToolTip.Tip>
                            <MultiBinding StringFormat="On time: {0}&#x0a;Off time: {1}">
                                <Binding Path="SlicerFile.DisplayTotalOnTimeString" />
                                <Binding Path="SlicerFile.DisplayTotalOffTimeString" />
                            </MultiBinding>
                        </ToolTip.Tip>
                    </TextBlock>


                    <TextBlock IsVisible="{Binding SlicerFile.MaterialMilliliters}"
                               Text="  |  " />
                    <TextBlock IsVisible="{Binding SlicerFile.MaterialMilliliters}"
                               Text="{Binding SlicerFile.MaterialMilliliters, StringFormat=Used material: {0}ml}" />


                    <TextBlock IsVisible="{Binding SlicerFile.MaterialCost}"
                               Text="  |  " />
                    <TextBlock IsVisible="{Binding SlicerFile.MaterialCost}"
                               Text="{Binding SlicerFile.MaterialCost, StringFormat=Material cost: {0:C}}" />


                    <TextBlock
                        IsVisible="{Binding SlicerFile.MaterialName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Text="  |  " />
                    <TextBlock
                        IsVisible="{Binding SlicerFile.MaterialName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Text="{Binding SlicerFile.MaterialName, StringFormat=Material: {0}}" />


                    <TextBlock
                        IsVisible="{Binding SlicerFile.MachineName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Text="  |  " />
                    <TextBlock
                        IsVisible="{Binding SlicerFile.MachineName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Text="{Binding SlicerFile.MachineName, StringFormat=Machine: {0}}" />
                </WrapPanel>
            </Border>

            <suki:GlassCard Margin="10"
                            Padding="10"
                            IsEnabled="{Binding IsFileLoaded}">
                <TabControl Name="MainTabControl"
                            Width="400"
                            DockPanel.Dock="Left"
                            SelectedItem="{Binding SelectedTabItem}">
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="32" />
                        </Style>
                    </TabControl.Styles>
                    <TabItem Name="TabInformation"
                             IsEnabled="{Binding IsFileLoaded}"
                             ToolTip.Tip="Information"
                             Header="{icon:MaterialIconExt Kind=InfoCircle}">


                        <Grid ColumnDefinitions="*"
                              IsVisible="{Binding IsFileLoaded}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto"
                                               MaxHeight="400" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*"
                                               MinHeight="200" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto"
                                               MinHeight="220" />
                            </Grid.RowDefinitions>
                            <!--  Thumbnails  -->
                            <uvtava:IndexSelector Name="ThumbnailIndexSelector"
                                                  Grid.Row="0"
                                                  BorderThickness="0"
                                                  Count="{Binding SlicerFile.ThumbnailsCount}"
                                                  IsVisible="{Binding SlicerFile.HaveThumbnails}"
                                                  SelectedIndex="{Binding VisibleThumbnailIndex}" />

                            <StackPanel Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding #ThumbnailIndexSelector.SelectedNumber}"
                                        IsVisible="{Binding SlicerFile.HaveThumbnails}"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                <SelectableTextBlock VerticalAlignment="Center"
                                                     Text="{Binding VisibleThumbnailResolution}" />

                                <SplitButton Command="{Binding ClickThumbnailImportFileCommand}"
                                             CommandParameter="False"
                                             Content="{icon:MaterialIconExt Image}"
                                             ToolTip.Tip="Replace the current preview image">
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Icon="{icon:MaterialIconExt Image}"
                                                      Command="{Binding ClickThumbnailImportFileCommand}"
                                                      CommandParameter="False"
                                                      Header="From file" />

                                            <MenuItem Icon="{icon:MaterialIconExt Image}"
                                                      Command="{Binding ClickThumbnailImportFileCommand}"
                                                      CommandParameter="True"
                                                      Header="From file (Replace all)" />

                                            <Separator />

                                            <MenuItem Icon="{icon:MaterialIconExt Layers}"
                                                      Command="{Binding ClickThumbnailImportCurrentLayerCommand}"
                                                      CommandParameter="False"
                                                      Header="From current layer" />

                                            <MenuItem Icon="{icon:MaterialIconExt Layers}"
                                                      Command="{Binding ClickThumbnailImportCurrentLayerCommand}"
                                                      CommandParameter="True"
                                                      Header="From current layer (Replace all)" />

                                            <MenuItem Icon="{icon:MaterialIconExt Layers}"
                                                      Command="{Binding ClickThumbnailImportRandomLayerCommand}"
                                                      CommandParameter="False"
                                                      Header="From random layer" />

                                            <MenuItem Icon="{icon:MaterialIconExt Layers}"
                                                      Command="{Binding ClickThumbnailImportRandomLayerCommand}"
                                                      CommandParameter="True"
                                                      Header="From random layer (Replace all)" />

                                            <Separator />

                                            <MenuItem Icon="{icon:MaterialIconExt Image360}"
                                                      Command="{Binding ClickThumbnailImportHeatmapCommand}"
                                                      CommandParameter="False"
                                                      Header="From heatmap" />

                                            <MenuItem Icon="{icon:MaterialIconExt Image360}"
                                                      Command="{Binding ClickThumbnailImportHeatmapCommand}"
                                                      CommandParameter="True"
                                                      Header="From heatmap (Replace all)" />
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>

                                <Button VerticalAlignment="Stretch"
                                        Content="{icon:MaterialIconExt Kind=ContentSave}"
                                        Command="{Binding ClickThumbnailSaveCommand}"
                                        ToolTip.Tip="Save thumbnail image to a file" />

                            </StackPanel>

                            <!--  Preview image  -->
                            <Image Grid.Row="1"
                                   IsVisible="{Binding SlicerFile.HaveThumbnails}"
                                   Source="{Binding VisibleThumbnailImage}"
                                   Stretch="Uniform" />

                            <GridSplitter Grid.Row="2"
                                          Height="5"
                                          IsVisible="{Binding SlicerFile.HaveThumbnails}"
                                          ResizeBehavior="PreviousAndNext"
                                          ResizeDirection="Rows" />

                            <!--  Properties  -->
                            <StackPanel Grid.Row="3"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding SlicerProperties.Count}"
                                        Orientation="Horizontal"
                                        Spacing="5">

                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding SlicerProperties.Count, StringFormat=Properties: {0}}" />

                                <TextBlock VerticalAlignment="Center"
                                           Text="|" />

                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding SlicerFile.Configs.Length, StringFormat=Groups: {0}}" />

                            </StackPanel>

                            <StackPanel Grid.Row="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding SlicerProperties.Count}"
                                        Orientation="Horizontal"
                                        Spacing="2">

                                <SplitButton Name="PropertiesSaveButton"
                                             Command="{Binding ClickPropertiesSaveClipboardCommand}"
                                             Content="{icon:MaterialIconExt ContentSave}"
                                             IsEnabled="{Binding SlicerFile.Configs.Length}"
                                             ToolTip.Tip="Save properties to a file or clipboard">
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Icon="{icon:MaterialIconExt FileExport}"
                                                      Command="{Binding ClickPropertiesSaveFileCommand}"
                                                      Header="To File" />

                                            <MenuItem Icon="{icon:MaterialIconExt Clipboard}"
                                                      Command="{Binding ClickPropertiesSaveClipboardCommand}"
                                                      Header="To Clipboard" />

                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>

                            </StackPanel>

                            <DataGrid Name="PropertiesGrid"
                                      Grid.Row="4"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True"
                                      ClipboardCopyMode="IncludeHeader"
                                      GridLinesVisibility="Horizontal"
                                      IsReadOnly="True"
                                      IsVisible="{Binding SlicerProperties.Count}"
                                      ItemsSource="{Binding SlicerProperties}"
                                      SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="Auto"
                                                        Binding="{Binding Name}"
                                                        Header="Name" />
                                    <DataGridTextColumn Width="Auto"
                                                        Binding="{Binding Value}"
                                                        Header="Value" />
                                    <DataGridTextColumn Width="Auto"
                                                        Binding="{Binding Group}"
                                                        Header="Group" />
                                </DataGrid.Columns>

                            </DataGrid>

                            <GridSplitter Grid.Row="5"
                                          ResizeBehavior="PreviousAndNext"
                                          ResizeDirection="Rows" />

                            <TextBlock Grid.Row="5"
                                       FontWeight="Bold"
                                       Text="Layer data"
                                       TextAlignment="Center"
                                       ToolTip.Tip="Shows the properties for the current selected layer" />

                            <!--  Layer data  -->

                            <DataGrid Name="CurrentLayerGrid"
                                      Grid.Row="6"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="False"
                                      CanUserSortColumns="False"
                                      ClipboardCopyMode="IncludeHeader"
                                      GridLinesVisibility="Horizontal"
                                      IsReadOnly="True"
                                      IsVisible="{Binding IsFileLoaded}"
                                      ItemsSource="{Binding CurrentLayerProperties}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="Auto"
                                                        Binding="{Binding Description}"
                                                        Header="Name" />
                                    <DataGridTextColumn Width="Auto"
                                                        Binding="{Binding Value}"
                                                        Header="Value" />
                                </DataGrid.Columns>

                            </DataGrid>


                        </Grid>

                    </TabItem>

                    <TabItem Name="TabGCode"
                             IsEnabled="{Binding HaveGCode}"
                             IsVisible="{Binding HaveGCode}"
                             ToolTip.Tip="GCode"
                             Header="{icon:MaterialIconExt Kind=CodeTags}">


                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Spacing="5">
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding GCodeLines, StringFormat=Lines: {0}}" />

                                <TextBlock VerticalAlignment="Center"
                                           Text="|" />

                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding #GCodeText.Text.Length, StringFormat=Chars: {0}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="2">

                                <ToggleButton Content="{icon:MaterialIconExt Kind=EditOutline}"
                                              IsChecked="{Binding SlicerFile.SuppressRebuildGCode}"
                                              ToolTip.Tip="Enable this to directly edit and use custom gcode. &#x0a;While this is active, UVtools won't update/generate the gcode, meaning any future change won't be replicated to gcode, unless you press the 'Refresh' button. &#x0a;To save the file with your custom gcode this setting must remain active while saving the file or else it will be re-generated. &#x0a;Use with caution and only if you know what you are doing!" />

                                <Button Content="{icon:MaterialIconExt Kind=Sync}"
                                        Command="{Binding ClickRebuildGcodeCommand}"
                                        ToolTip.Tip="Rebuild GCode with current settings" />

                                <SplitButton Command="{Binding ClickGCodeSaveClipboardCommand}"
                                             Content="{icon:MaterialIconExt ContentSave}"
                                             ToolTip.Tip="Save gcode to a file or clipboard">
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Icon="{icon:MaterialIconExt Kind=ContentSave}"
                                                      Command="{Binding ClickGCodeSaveFileCommand}"
                                                      Header="To File" />

                                            <MenuItem Icon="{icon:MaterialIconExt Kind=ClipboardOutline}"
                                                      Command="{Binding ClickGCodeSaveClipboardCommand}"
                                                      Header="To Clipboard" />

                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>

                            </StackPanel>

                            <!--
							<avaloniaEdit:TextEditor Name="GCodeText2"
							Grid.Row="1"
							IsReadOnly="{Binding !SlicerFile.SuppressRebuildGCode}"
							ShowLineNumbers="True"/>
							!-->
                            <TextBox Name="GCodeText"
                                     Grid.Row="1"
                                     AcceptsReturn="True"
                                     IsReadOnly="{Binding !SlicerFile.SuppressRebuildGCode}"
                                     Text="{Binding SlicerFile.GCodeStr}" />

                        </Grid>

                    </TabItem>

                    <!--
					Issues Tab
					-->
                    <TabItem Name="TabIssues"
                             IsEnabled="{Binding IsFileLoaded}"
                             ToolTip.Tip="Issues"
                             Header="{icon:MaterialIconExt Kind=RadiationCircle}">


                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding IsFileLoaded}"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                <uvtava:IndexSelector AllowSelectNone="True"
                                                      BorderThickness="0"
                                                      Count="{Binding SlicerFile.IssueManager.Count}"
                                                      SelectedIndex="{Binding IssueSelectedIndex}"
                                                      ZeroLeading="True">
                                    <uvtava:IndexSelector.Styles>
                                        <Style Selector="RepeatButton#PART_PreviousButton">
                                            <Setter Property="HotKey" Value="Ctrl + Shift + Down" />
                                            <Setter Property="ToolTip.Tip"
                                                    Value="Go to the previous issue [Ctrl + Shift + Down]" />
                                        </Style>
                                        <Style Selector="RepeatButton#PART_NextButton">
                                            <Setter Property="HotKey" Value="Ctrl + Shift + Up" />
                                            <Setter Property="ToolTip.Tip"
                                                    Value="Go to the next issue [Ctrl + Shift + Up]" />
                                        </Style>
                                    </uvtava:IndexSelector.Styles>
                                </uvtava:IndexSelector>

                                <Button VerticalAlignment="Stretch"
                                        Content="{icon:MaterialIconExt Kind=EyeOff}"
                                        Command="{Binding ClickIssueIgnoreCommand}"
                                        IsEnabled="{Binding #IssuesGrid.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        ToolTip.Tip="Hides and ignores the selected issues, they won't be re-detected. &#x0a;ALT + Click to re-enable the ignored issues." />

                                <Button VerticalAlignment="Stretch"
                                        Content="{icon:MaterialIconExt Kind=TrashCan}"
                                        Command="{Binding ClickIssueRemoveCommand}"
                                        IsEnabled="{Binding #IssuesGrid.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        ToolTip.Tip="Remove the selected issue(s) when possible. &#x0a;Islands: All pixels are removed (turn black). &#x0a;ResinTrap: All areas are filled with white pixels. &#x0a;SuctionCup: Drills a vertical vent hole. &#x0a;EmptyLayers: Layers are removed." />

                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="2">

                                <Button VerticalAlignment="Stretch"
                                        Content="{icon:MaterialIconExt Kind=Toolbox}"
                                        Command="{Binding ClickRepairIssuesCommand}"
                                        IsEnabled="{Binding IsFileLoaded}"
                                        ToolTip.Tip="Attempt to repair issues" />

                                <SplitButton VerticalAlignment="Stretch"
                                             Command="{Binding ClickDetectIssuesCommand}"
                                             Content="{icon:MaterialIconTextExt Kind=Sync, Text='Detect'}"
                                             ToolTip.Tip="Compute Issues. &#x0a;Right click to access settings.">
                                    <SplitButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Islands"
                                                      ToggleType="CheckBox"
                                                      IsChecked="{Binding Settings.Issues.ComputeIslands, Mode=TwoWay}" />
                                            <MenuItem Header="Overhangs"
                                                      ToggleType="CheckBox"
                                                      IsChecked="{Binding Settings.Issues.ComputeOverhangs, Mode=TwoWay}" />

                                            <MenuItem ToggleType="CheckBox"
                                                      IsChecked="{Binding Settings.Issues.ComputeResinTraps, Mode=TwoWay}">


                                                <MenuItem.Header>


                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center"
                                                                   Text="Resin traps" />

                                                        <NumericUpDown Width="110"
                                                                       Margin="10,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Increment="1"
                                                                       Maximum="{Binding SlicerFile.LastLayerIndex}"
                                                                       Minimum="0"
                                                                       ToolTip.Tip="Starting layer index for resin trap detection which will also be considered a drain layer. &#x0a;Use this setting to bypass complicated rafts by select the model first real layer."
                                                                       Value="{Binding ResinTrapDetectionStartLayer}" />

                                                        <Button Margin="2,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding SetResinTrapDetectionStartLayerCommand}"
                                                                CommandParameter="N"
                                                                Content="N"
                                                                ToolTip.Tip="Set to the first normal layer" />
                                                        <Button Margin="2,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding SetResinTrapDetectionStartLayerCommand}"
                                                                CommandParameter="C"
                                                                Content="C"
                                                                ToolTip.Tip="Set to the current layer" />
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>

                                            <MenuItem VerticalAlignment="Center"
                                                      Header="Suction cups"
                                                      ToggleType="CheckBox"
                                                      IsChecked="{Binding Settings.Issues.ComputeSuctionCups, Mode=TwoWay}"
                                                      IsEnabled="{Binding Settings.Issues.ComputeResinTraps}" />

                                            <MenuItem Header="Touching bounds"
                                                      ToggleType="CheckBox"
                                                      IsChecked="{Binding Settings.Issues.ComputeTouchingBounds, Mode=TwoWay}" />
                                            <MenuItem Header="Print height"
                                                      ToggleType="CheckBox"
                                                      IsChecked="{Binding Settings.Issues.ComputePrintHeight, Mode=TwoWay}" />
                                            <MenuItem Header="Empty layers"
                                                      ToggleType="CheckBox"
                                                      IsChecked="{Binding Settings.Issues.ComputeEmptyLayers, Mode=TwoWay}" />
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>

                            </StackPanel>

                            <DataGrid Name="IssuesGrid"
                                      Grid.Row="1"
                                      CanUserReorderColumns="True"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True"
                                      ClipboardCopyMode="None"
                                      GridLinesVisibility="Horizontal"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding IssuesGridItems}"
                                      SelectedIndex="{Binding IssueSelectedIndex}"
                                      SelectionMode="Extended">
                                <DataGrid.ContextMenu>
                                    <ContextMenu
                                        IsVisible="{Binding $parent[DataGrid].SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <MenuItem Icon="{icon:MaterialIconExt EyeOff}"
                                                  Command="{Binding ClickIssueIgnoreCommand}"
                                                  Header="Ignore issue(s)" />
                                        <Separator />
                                        <MenuItem Icon="{icon:MaterialIconExt TrashCan}"
                                                  Command="{Binding SelectedIssuesIslandRemoveCommand}"
                                                  Header="Remove island(s)"
                                                  IsVisible="{Binding #IssuesGrid.((layers:MainIssue)SelectedItem).IsIsland}" />
                                        <MenuItem Icon="{icon:MaterialIconExt Rhombus}"
                                                  Command="{Binding SelectedIssuesResinTrapSolidifyCommand}"
                                                  Header="Fill/solidify resin trap(s)"
                                                  IsVisible="{Binding #IssuesGrid.((layers:MainIssue)SelectedItem).IsResinTrap}" />
                                        <MenuItem Icon="{icon:MaterialIconExt CircleBox}"
                                                  Command="{Binding SelectedIssuesSuctionCupDrillCommand}"
                                                  Header="Drill suction cup(s)"
                                                  IsVisible="{Binding #IssuesGrid.((layers:MainIssue)SelectedItem).IsSuctionCup}" />
                                        <MenuItem Icon="{icon:MaterialIconExt Rhombus}"
                                                  Command="{Binding SelectedIssuesSuctionCupSolidifyCommand}"
                                                  Header="Fill/solidify suction cup(s)"
                                                  IsVisible="{Binding #IssuesGrid.((layers:MainIssue)SelectedItem).IsSuctionCup}" />
                                        <MenuItem Icon="{icon:MaterialIconExt TrashCan}"
                                                  Command="{Binding SelectedIssuesEmptyLayerRemoveCommand}"
                                                  Header="Remove empty layer(s)"
                                                  IsVisible="{Binding #IssuesGrid.((layers:MainIssue)SelectedItem).IsEmptyLayer}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>

                                    <DataGridTextColumn Width="Auto"
                                                        Binding="{Binding Type, DataType={x:Type layers:MainIssue}}"
                                                        Header="Type" />
                                    <DataGridTextColumn Width="Auto"
                                                        Binding="{Binding LayerInfoString, DataType={x:Type layers:MainIssue}}"
                                                        Header="Layer(s)"
                                                        SortMemberPath="StartLayerIndex" />
                                    <DataGridTextColumn Width="Auto"
                                                        Binding="{Binding Area, DataType={x:Type layers:MainIssue},
														StringFormat={}{0:N0}}"
                                                        Header="Area" />
                                </DataGrid.Columns>

                            </DataGrid>


                        </Grid>


                    </TabItem>

                    <!--
					Suggestions Tab
					-->
                    <TabItem Name="TabSuggestions"
                             IsEnabled="{Binding IsFileLoaded}"
                             IsVisible="{Binding Suggestions.Length}"
                             ToolTip.Tip="Suggestions, automations and analyzer"
                             Header="{icon:MaterialIconExt Kind=Security}">


                        <Grid ColumnDefinitions="*">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*"
                                               MinHeight="200" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*"
                                               MinHeight="200" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  ColumnDefinitions="Auto,2,Auto,*"
                                  RowDefinitions="Auto">
                                <Button Grid.Column="0"
                                        Command="{Binding #SuggestionsAvailableListBox.UnselectAll}"
                                        Content="{icon:MaterialIconTextExt Kind=CheckBoxOutlineBlank, Text='Unselect all'}" />

                                <Button Grid.Column="2"
                                        Command="{Binding #SuggestionsAvailableListBox.SelectAll}"
                                        Content="{icon:MaterialIconTextExt Kind=CheckboxOutline, Text='Select all'}" />

                                <StackPanel Grid.Column="3"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                    <Button Command="{Binding ApplySuggestionsClickedCommand}"
                                            IsEnabled="{Binding #SuggestionsAvailableListBox.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Content="{icon:MaterialIconTextExt Kind=Check, Text='Apply'}" />

                                    <Button VerticalAlignment="Stretch"
                                            Command="{Binding ConfigureSuggestionsClickedCommand}"
                                            Content="{icon:MaterialIconExt Kind=Cog}"
                                            ToolTip.Tip="Configure suggestions" />
                                </StackPanel>

                            </Grid>

                            <ListBox Name="SuggestionsAvailableListBox"
                                     Grid.Row="1"
                                     ItemsSource="{Binding SuggestionsAvailable}"
                                     SelectionMode="Multiple,Toggle">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   ToolTip.Tip="{Binding ToolTip}">
                                            <!--<TextBlock.IsVisible>
											<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="Enabled"/>
											<Binding Path="!IsApplied"/>
											</MultiBinding>
											</TextBlock.IsVisible>
											!-->
                                            <TextBlock.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Icon="{icon:MaterialIconExt Check}"
                                                              Command="{Binding $parent[windows:GenericWindow].((ui:MainWindow)DataContext).ApplySuggestionClickedCommand}"
                                                              CommandParameter="{Binding .}"
                                                              Header="Apply"
                                                              IsVisible="{Binding !IsInformativeOnly}" />
                                                    <MenuItem Icon="{icon:MaterialIconExt InfoCircle}"
                                                              Command="{Binding $parent[windows:GenericWindow].((ui:MainWindow)DataContext).OpenWebsiteCommand}"
                                                              CommandParameter="{Binding InformationUrl}"
                                                              Header="More information (Web)"
                                                              IsVisible="{Binding InformationUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <MenuItem Icon="{icon:MaterialIconExt Cog}"
                                                              Command="{Binding $parent[windows:GenericWindow].((ui:MainWindow)DataContext).ConfigureSuggestionClickedCommand}"
                                                              CommandParameter="{Binding .}"
                                                              Header="Configure" />
                                                </ContextMenu>
                                            </TextBlock.ContextMenu>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <GridSplitter Grid.Row="2"
                                          ResizeBehavior="PreviousAndNext"
                                          ResizeDirection="Rows" />

                            <TextBlock Grid.Row="2"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="Applied suggestions:" />

                            <ListBox Grid.Row="3"
                                     ItemsSource="{Binding SuggestionsApplied}"
                                     SelectionMode="AlwaysSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   ToolTip.Tip="{Binding ToolTip}">
                                            <!--<TextBlock.IsVisible>
											<MultiBinding Converter="{x:Static BoolConverters.And}">
											<Binding Path="Enabled"/>
											<Binding Path="IsApplied"/>
											</MultiBinding>
											</TextBlock.IsVisible>
											!-->
                                            <TextBlock.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Icon="{icon:MaterialIconExt InfoCircle}"
                                                              Command="{Binding $parent[windows:GenericWindow].((ui:MainWindow)DataContext).OpenWebsiteCommand}"
                                                              CommandParameter="{Binding InformationUrl}"
                                                              Header="More information (Web)"
                                                              IsVisible="{Binding InformationUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <MenuItem Icon="{icon:MaterialIconExt Cog}"
                                                              Command="{Binding $parent[windows:GenericWindow].((ui:MainWindow)DataContext).ConfigureSuggestionClickedCommand}"
                                                              CommandParameter="{Binding .}"
                                                              Header="Configure" />
                                                </ContextMenu>
                                            </TextBlock.ContextMenu>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                    </TabItem>

                    <!--  Pixel Editor !  -->
                    <TabItem Name="TabPixelEditor"
                             IsEnabled="{Binding IsPixelEditorActive}"
                             IsVisible="{Binding IsPixelEditorActive}"
                             Header="{icon:MaterialIconExt Kind=RulerSquareCompass}"
                             ToolTip.Tip="Pixel editor">


                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid RowDefinitions="Auto,20,Auto,*">
                                <TabControl Padding="10,0"
                                            SelectedIndex="{Binding SelectedPixelOperationTabIndex}">
                                    <!--  Drawing !  -->
                                    <TabControl.Styles>
                                        <Style Selector="TabItem">
                                            <Setter Property="FontSize" Value="24" />
                                        </Style>
                                    </TabControl.Styles>
                                    <TabItem ToolTip.Tip="Drawing">
                                        <TabItem.Header>
                                            <StackPanel VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="5">
                                                <icon:MaterialIcon Kind="Brush" />
                                                <TextBlock IsVisible="{Binding $parent[TabItem].IsSelected}"
                                                           VerticalAlignment="Center"
                                                           Classes="h5"
                                                           Text="Drawing" />
                                            </StackPanel>
                                        </TabItem.Header>

                                        <StackPanel Spacing="10">
                                            <Border Background="{DynamicResource LightBackground}"
                                                    BorderBrush="Black"
                                                    BorderThickness="1">
                                                <TextBlock Padding="10"
                                                           Text="Shift+Left click to add white pixels     &#x0a;Shift+Right click to remove pixels" />
                                            </Border>

                                            <fragments:PixelEditorProfilesFragment
                                                Profiles="{Binding DrawingPixelDrawingProfiles}"
                                                Source="{Binding DrawingPixelDrawing}" />

                                            <Grid ColumnDefinitions="Auto,10,*,5,40"
                                                  RowDefinitions="Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto">

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Line type:" />
                                                <ComboBox Grid.Row="0"
                                                          Grid.Column="2"
                                                          Grid.ColumnSpan="3"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding DrawingPixelDrawing.LineTypes}"
                                                          SelectedItem="{Binding DrawingPixelDrawing.LineType}" />

                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Brush shape:" />
                                                <ComboBox Grid.Row="2"
                                                          Grid.Column="2"
                                                          Grid.ColumnSpan="3"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding DrawingPixelDrawing.BrushShape, Converter={StaticResource EnumToCollectionConverter}, Mode=OneTime}"
                                                          SelectedItem="{Binding DrawingPixelDrawing.BrushShape, Converter={StaticResource FromValueDescriptionToEnumConverter}}" />

                                                <TextBlock Grid.Row="4"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Rotation angle:" />
                                                <NumericUpDown Grid.Row="4"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               suki:NumericUpDownExtensions.Unit="º"
                                                               FormatString="F2"
                                                               Maximum="360"
                                                               Minimum="-360"
                                                               Value="{Binding DrawingPixelDrawing.RotationAngle}" />

                                                <TextBlock Grid.Row="6"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Brush diameter:" />
                                                <NumericUpDown Grid.Row="6"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               HorizontalAlignment="Stretch"
                                                               suki:NumericUpDownExtensions.Unit="px"
                                                               Maximum="4000"
                                                               Minimum="1"
                                                               Value="{Binding DrawingPixelDrawing.BrushSize}" />

                                                <TextBlock Grid.Row="8"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Thickness:" />
                                                <NumericUpDown Grid.Row="8"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               HorizontalAlignment="Stretch"
                                                               suki:NumericUpDownExtensions.Unit="px"
                                                               Maximum="255"
                                                               Minimum="-1"
                                                               Value="{Binding DrawingPixelDrawing.Thickness}" />

                                                <TextBlock Grid.Row="10"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Remove pixel brightness:" />
                                                <NumericUpDown Grid.Row="10"
                                                               Grid.Column="2"
                                                               HorizontalAlignment="Stretch"
                                                               Maximum="255"
                                                               Minimum="0"
                                                               Value="{Binding DrawingPixelDrawing.RemovePixelBrightness}" />
                                                <TextBlock Grid.Row="10"
                                                           Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DrawingPixelDrawing.RemovePixelBrightnessPercent, StringFormat={}{0:0}%}" />

                                                <TextBlock Grid.Row="12"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Add pixel brightness:" />
                                                <NumericUpDown Grid.Row="12"
                                                               Grid.Column="2"
                                                               HorizontalAlignment="Stretch"
                                                               Maximum="255"
                                                               Minimum="1"
                                                               Value="{Binding DrawingPixelDrawing.PixelBrightness}" />
                                                <TextBlock Grid.Row="12"
                                                           Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DrawingPixelDrawing.PixelBrightnessPercent, StringFormat={}{0:0}%}" />

                                                <TextBlock Grid.Row="14"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Layers depth below:" />
                                                <NumericUpDown Grid.Row="14"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               HorizontalAlignment="Stretch"
                                                               suki:NumericUpDownExtensions.Unit="{icon:MaterialIconExt Kind=Layers}"
                                                               Minimum="0"
                                                               Value="{Binding DrawingPixelDrawing.LayersBelow}" />


                                                <TextBlock Grid.Row="16"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Layers depth above:" />
                                                <NumericUpDown Grid.Row="16"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               HorizontalAlignment="Stretch"
                                                               suki:NumericUpDownExtensions.Unit="{icon:MaterialIconExt Kind=Layers}"
                                                               Minimum="0"
                                                               Value="{Binding DrawingPixelDrawing.LayersAbove}" />

                                            </Grid>

                                        </StackPanel>

                                    </TabItem>

                                    <!--  Text !  -->
                                    <TabItem ToolTip.Tip="Text">
                                        <TabItem.Header>
                                            <StackPanel VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="5">
                                                <icon:MaterialIcon Kind="FormatText" />
                                                <TextBlock IsVisible="{Binding $parent[TabItem].IsSelected}"
                                                           VerticalAlignment="Center"
                                                           Classes="h5"
                                                           Text="Text" />
                                            </StackPanel>
                                        </TabItem.Header>

                                        <StackPanel Spacing="10">
                                            <Border Background="{DynamicResource LightBackground}"
                                                    BorderBrush="Black"
                                                    BorderThickness="1">
                                                <TextBlock Padding="10"
                                                           Text="Shift+Left click to add text     &#x0a;Shift+Right click to remove text" />
                                            </Border>

                                            <fragments:PixelEditorProfilesFragment
                                                Profiles="{Binding DrawingPixelTextProfiles}"
                                                Source="{Binding DrawingPixelText}" />

                                            <Grid ColumnDefinitions="Auto,10,*,5,40"
                                                  RowDefinitions="Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto">

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Line type:" />
                                                <ComboBox Grid.Row="0"
                                                          Grid.Column="2"
                                                          Grid.ColumnSpan="3"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding DrawingPixelText.LineTypes}"
                                                          SelectedItem="{Binding DrawingPixelText.LineType}" />

                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Font face:" />
                                                <ComboBox Grid.Row="2"
                                                          Grid.Column="2"
                                                          Grid.ColumnSpan="3"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding DrawingPixelText.FontFaces}"
                                                          SelectedItem="{Binding DrawingPixelText.Font}" />

                                                <TextBlock Grid.Row="4"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Font scale:" />
                                                <NumericUpDown Grid.Row="4"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               Increment="0.1"
                                                               Maximum="255"
                                                               Minimum="0.1"
                                                               Value="{Binding DrawingPixelText.FontScale}" />


                                                <TextBlock Grid.Row="6"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Thickness:" />
                                                <NumericUpDown Grid.Row="6"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               suki:NumericUpDownExtensions.Unit="px"
                                                               Maximum="255"
                                                               Minimum="1"
                                                               Value="{Binding DrawingPixelText.Thickness}" />

                                                <TextBlock Grid.Row="8"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Text:" />
                                                <TextBox Grid.Row="8"
                                                         Grid.Column="2"
                                                         Grid.ColumnSpan="3"
                                                         Height="90"
                                                         AcceptsReturn="True"
                                                         Text="{Binding DrawingPixelText.Text}" />

                                                <TextBlock Grid.Row="10"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Line alignment:" />
                                                <ComboBox Grid.Row="10"
                                                          Grid.Column="2"
                                                          Grid.ColumnSpan="3"
                                                          HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding DrawingPixelText.LineAlignment, Converter={StaticResource EnumToCollectionConverter}, Mode=OneTime}"
                                                          SelectedItem="{Binding DrawingPixelText.LineAlignment, Converter={StaticResource FromValueDescriptionToEnumConverter}}" />

                                                <CheckBox Grid.Row="12"
                                                          Grid.Column="2"
                                                          Grid.ColumnSpan="3"
                                                          Content="Flip text Vertically"
                                                          IsChecked="{Binding DrawingPixelText.Mirror}" />

                                                <TextBlock Grid.Row="14"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Rotation angle:" />
                                                <NumericUpDown Grid.Row="14"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               suki:NumericUpDownExtensions.Unit="º"
                                                               FormatString="F2"
                                                               Maximum="360"
                                                               Minimum="-360"
                                                               Value="{Binding DrawingPixelText.Angle}" />

                                                <TextBlock Grid.Row="16"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Remove pixel brightness:" />
                                                <NumericUpDown Grid.Row="16"
                                                               Grid.Column="2"
                                                               Maximum="255"
                                                               Minimum="0"
                                                               Value="{Binding DrawingPixelText.RemovePixelBrightness}" />
                                                <TextBlock Grid.Row="16"
                                                           Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DrawingPixelText.RemovePixelBrightnessPercent, StringFormat={}{0:0}%}" />

                                                <TextBlock Grid.Row="18"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Add pixel brightness:" />
                                                <NumericUpDown Grid.Row="18"
                                                               Grid.Column="2"
                                                               Maximum="255"
                                                               Minimum="1"
                                                               Value="{Binding DrawingPixelText.PixelBrightness}" />
                                                <TextBlock Grid.Row="18"
                                                           Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DrawingPixelText.PixelBrightnessPercent, StringFormat={}{0:0}%}" />


                                                <TextBlock Grid.Row="20"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Layers depth below:" />
                                                <NumericUpDown Grid.Row="20"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               suki:NumericUpDownExtensions.Unit="{icon:MaterialIconExt Kind=Layers}"
                                                               Minimum="0"
                                                               Value="{Binding DrawingPixelText.LayersBelow}" />


                                                <TextBlock Grid.Row="22"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Layers depth above:" />
                                                <NumericUpDown Grid.Row="22"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               suki:NumericUpDownExtensions.Unit="{icon:MaterialIconExt Kind=Layers}"
                                                               Minimum="0"
                                                               Value="{Binding DrawingPixelText.LayersAbove}" />

                                            </Grid>

                                        </StackPanel>

                                    </TabItem>

                                    <!--  Fill !  -->
                                    <TabItem ToolTip.Tip="Fill / Erase">
                                        <TabItem.Header>
                                            <StackPanel VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="5">
                                                <icon:MaterialIcon Kind="FormatColorFill" />
                                                <TextBlock IsVisible="{Binding $parent[TabItem].IsSelected}"
                                                           VerticalAlignment="Center"
                                                           Classes="h5"
                                                           Text="Fill" />
                                            </StackPanel>
                                        </TabItem.Header>

                                        <StackPanel Spacing="10">
                                            <Border Background="{DynamicResource LightBackground}"
                                                    BorderBrush="Black"
                                                    BorderThickness="1">
                                                <TextBlock Padding="10"
                                                           Text="Shift+Left click to fill the linked area.     &#x0a;Shift+Right click to erase the linked area." />
                                            </Border>

                                            <fragments:PixelEditorProfilesFragment
                                                Profiles="{Binding DrawingPixelFillProfiles}"
                                                Source="{Binding DrawingPixelFill}" />

                                            <Grid ColumnDefinitions="Auto,10,*,10,40"
                                                  RowDefinitions="Auto,10,Auto,10,Auto,10,Auto">

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Erase brightness:" />
                                                <NumericUpDown Grid.Row="0"
                                                               Grid.Column="2"
                                                               suki:NumericUpDownExtensions.Unit="{icon:MaterialIconExt Kind=Brightness5}"
                                                               Maximum="255"
                                                               Minimum="0"
                                                               Value="{Binding DrawingPixelFill.ErasePixelBrightness}" />
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DrawingPixelFill.ErasePixelBrightnessPercent, StringFormat={}{0:0}%}" />

                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Fill brightness:" />
                                                <NumericUpDown Grid.Row="2"
                                                               Grid.Column="2"
                                                               suki:NumericUpDownExtensions.Unit="{icon:MaterialIconExt Kind=Brightness5}"
                                                               Maximum="255"
                                                               Minimum="0"
                                                               Value="{Binding DrawingPixelFill.PixelBrightness}" />
                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DrawingPixelFill.PixelBrightnessPercent, StringFormat={}{0:0}%}" />

                                                <TextBlock Grid.Row="4"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Layers depth below:" />
                                                <NumericUpDown Grid.Row="4"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               suki:NumericUpDownExtensions.Unit="{icon:MaterialIconExt Kind=Layers}"
                                                               Minimum="0"
                                                               Value="{Binding DrawingPixelFill.LayersBelow}" />

                                                <TextBlock Grid.Row="6"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Layers depth above:" />
                                                <NumericUpDown Grid.Row="6"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               suki:NumericUpDownExtensions.Unit="{icon:MaterialIconExt Kind=Layers}"
                                                               Minimum="0"
                                                               Value="{Binding DrawingPixelFill.LayersAbove}" />


                                            </Grid>

                                        </StackPanel>

                                    </TabItem>

                                    <!--  Supports !  -->
                                    <TabItem ToolTip.Tip="Supports">
                                        <TabItem.Header>
                                            <StackPanel VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="5">
                                                <icon:MaterialIcon Kind="SourceBranch" />
                                                <TextBlock IsVisible="{Binding $parent[TabItem].IsSelected}"
                                                           VerticalAlignment="Center"
                                                           Classes="h5"
                                                           Text="Supports" />
                                            </StackPanel>
                                        </TabItem.Header>

                                        <StackPanel Spacing="10">
                                            <Border Background="{DynamicResource LightBackground}"
                                                    BorderBrush="Black"
                                                    BorderThickness="1">
                                                <TextBlock Padding="10"
                                                           Text="Shift+click under a island to add primitive support.     &#x0a;Note: this operation can't be previewed." />
                                            </Border>

                                            <fragments:PixelEditorProfilesFragment
                                                Profiles="{Binding DrawingPixelSupportProfiles}"
                                                Source="{Binding DrawingPixelSupport}" />

                                            <Grid ColumnDefinitions="Auto,10,*,5,35"
                                                  RowDefinitions="Auto,10,Auto,10,Auto,10,Auto">
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Tip diameter:" />
                                                <NumericUpDown Grid.Row="0"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               suki:NumericUpDownExtensions.Unit="px"
                                                               Maximum="255"
                                                               Minimum="1"
                                                               Value="{Binding DrawingPixelSupport.TipDiameter}" />

                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Pillar diameter:" />
                                                <NumericUpDown Grid.Row="2"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               suki:NumericUpDownExtensions.Unit="px"
                                                               Maximum="255"
                                                               Minimum="1"
                                                               Value="{Binding DrawingPixelSupport.PillarDiameter}" />

                                                <TextBlock Grid.Row="4"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Base diameter:" />
                                                <NumericUpDown Grid.Row="4"
                                                               Grid.Column="2"
                                                               Grid.ColumnSpan="3"
                                                               suki:NumericUpDownExtensions.Unit="px"
                                                               Maximum="255"
                                                               Minimum="1"
                                                               Value="{Binding DrawingPixelSupport.BaseDiameter}" />

                                                <TextBlock Grid.Row="6"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Pixel brightness:" />
                                                <NumericUpDown Grid.Row="6"
                                                               Grid.Column="2"
                                                               suki:NumericUpDownExtensions.Unit="{icon:MaterialIconExt Kind=Brightness5}"
                                                               Maximum="255"
                                                               Minimum="0"
                                                               Value="{Binding DrawingPixelSupport.PixelBrightness}" />
                                                <TextBlock Grid.Row="6"
                                                           Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DrawingPixelSupport.PixelBrightnessPercent, StringFormat={}{0:0}%}" />

                                            </Grid>
                                        </StackPanel>

                                    </TabItem>

                                    <!--  Drain holes !  -->
                                    <TabItem ToolTip.Tip="Drain holes">
                                        <TabItem.Header>
                                            <StackPanel VerticalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="5">
                                                <icon:MaterialIcon Kind="ChartDonut" />
                                                <TextBlock IsVisible="{Binding $parent[TabItem].IsSelected}"
                                                           VerticalAlignment="Center"
                                                           Classes="h5"
                                                           Text="Drain holes" />
                                            </StackPanel>
                                        </TabItem.Header>

                                        <StackPanel Spacing="10">
                                            <Border Background="{DynamicResource LightBackground}"
                                                    BorderBrush="Black"
                                                    BorderThickness="1">
                                                <TextBlock Padding="10"
                                                           Text="Shift+click to add a vertical drain hole.     &#x0a;Note: this operation can't be previewed." />
                                            </Border>

                                            <fragments:PixelEditorProfilesFragment
                                                Profiles="{Binding DrawingPixelDrainHoleProfiles}"
                                                Source="{Binding DrawingPixelDrainHole}" />

                                            <Grid ColumnDefinitions="Auto,10,*"
                                                  RowDefinitions="Auto">
                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="Hole diameter:" />
                                                <NumericUpDown Grid.Row="0"
                                                               Grid.Column="2"
                                                               suki:NumericUpDownExtensions.Unit="px"
                                                               Maximum="255"
                                                               Minimum="20"
                                                               Value="{Binding DrawingPixelDrainHole.Diameter}" />
                                            </Grid>
                                        </StackPanel>

                                    </TabItem>

                                </TabControl>

                                <!--  Toolbar !  -->
                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            Spacing="1">
                                    <Button Command="{Binding ClickDrawingRemoveCommand}"
                                            IsEnabled="{Binding #DrawingsGrid.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                                            Content="{icon:MaterialIconTextExt Kind=TrashCan, Text='Remove'}" />

                                    <Button Command="{Binding ClickDrawingClearCommand}"
                                            IsEnabled="{Binding Drawings.Count}"
                                            Content="{icon:MaterialIconTextExt Kind=DeleteSweep, Text='Clear'}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="10">

                                    <Button Command="{Binding ApplyDrawModificationsCommand}"
                                            IsEnabled="{Binding Drawings.Count}"
                                            Content="{icon:MaterialIconTextExt Kind=Check, Text={Binding Drawings.Count, StringFormat='Apply {0} operations'}}" />
                                </StackPanel>

                                <DataGrid Name="DrawingsGrid"
                                          Grid.Row="3"
                                          CanUserReorderColumns="True"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          CellPointerPressed="DrawingsGrid_OnCellPointerPressed"
                                          ClipboardCopyMode="IncludeHeader"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="All"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding Drawings}"
                                          KeyUp="DrawingsGrid_OnKeyUp"
                                          LoadingRow="DrawingsGrid_OnLoadingRow"
                                          RowHeaderWidth="50"
                                          SelectionChanged="DrawingsGrid_OnSelectionChanged"
                                          SelectionMode="Extended">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="Auto"
                                                            Binding="{Binding OperationType}"
                                                            Header="Operation" />
                                        <DataGridTextColumn Width="Auto"
                                                            Binding="{Binding LayerIndex}"
                                                            Header="Layer" />
                                        <DataGridTextColumn Width="Auto"
                                                            Binding="{Binding Location}"
                                                            Header="Position (X, Y)" />
                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>
                        </ScrollViewer>
                    </TabItem>


                    <TabItem Name="TabClipboard"
                             IsEnabled="{Binding IsFileLoaded}"
                             ToolTip.Tip="Clipboard"
                             Header="{icon:MaterialIconExt Kind=ClipboardTextOutline}">


                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*"
                                               MinHeight="140" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*"
                                               MinHeight="180" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="2">

                                <Button Content="{icon:MaterialIconExt Kind=Undo}"
                                        Command="{Binding ClipboardUndoCommand}"
                                        HotKey="Ctrl + Z"
                                        IsEnabled="{Binding ClipboardManager.CanUndo}"
                                        ToolTip.Tip="Undo [Ctrl + Z] &#x0a;Shift + Click to Undo and edit last operation [Ctrl + Shift + Z]" />

                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}/{1}">
                                            <Binding Path="ClipboardManager.CurrentIndexCountString" />
                                            <Binding Path="ClipboardManager.Items.Count" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <Button Content="{icon:MaterialIconExt Kind=Redo}"
                                        Command="{Binding ClipboardRedoCommand}"
                                        HotKey="Ctrl + Y"
                                        IsEnabled="{Binding ClipboardManager.CanRedo}"
                                        ToolTip.Tip="Redo [Ctrl + Y]" />

                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                <Button Content="{icon:MaterialIconExt Kind=DeleteSweep}"
                                        Command="{Binding ClipboardClearCommand}"
                                        IsEnabled="{Binding ClipboardManager.Items.Count}"
                                        ToolTip.Tip="Clear all clips" />
                            </StackPanel>

                            <ListBox Name="ClipboardList"
                                     Grid.Row="1"
                                     AutoScrollToSelectedItem="True"
                                     ItemsSource="{Binding ClipboardManager.Items}"
                                     SelectedIndex="{Binding ClipboardManager.CurrentIndex}"
                                     SelectionMode="Single" />

                            <GridSplitter Grid.Row="2"
                                          ResizeBehavior="PreviousAndNext"
                                          ResizeDirection="Rows" />

                            <Grid Grid.Row="3"
                                  ColumnDefinitions="*"
                                  RowDefinitions="Auto,*">
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="Auto,*,Auto"
                                      RowDefinitions="Auto">
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Logs.Count, StringFormat=Operations: {0}}" />

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Text="Logs" />

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="5">
                                        <CheckBox VerticalAlignment="Center"
                                                  Content="Verbose"
                                                  IsChecked="{Binding IsVerbose}"
                                                  ToolTip.Tip="Shows extra information useful to debug problems." />

                                        <Button VerticalAlignment="Center"
                                                Content="{icon:MaterialIconExt Kind=DeleteSweep}"
                                                Command="{Binding Logs.Clear}"
                                                ToolTip.Tip="Clear all logs" />
                                    </StackPanel>

                                </Grid>

                                <DataGrid Grid.Row="1"
                                          VerticalAlignment="Stretch"
                                          CanUserReorderColumns="True"
                                          CanUserResizeColumns="True"
                                          CanUserSortColumns="True"
                                          ClipboardCopyMode="IncludeHeader"
                                          GridLinesVisibility="All"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding Logs}"
                                          SelectionMode="Extended">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="Auto"
                                                            Binding="{Binding Index}"
                                                            Header="#" />
                                        <DataGridTextColumn Width="Auto"
                                                            Binding="{Binding StartTime}"
                                                            Header="Started" />
                                        <DataGridTextColumn Width="Auto"
                                                            Binding="{Binding ElapsedTime}"
                                                            Header="Time(s)" />
                                        <DataGridTextColumn Width="Auto"
                                                            Binding="{Binding Description}"
                                                            Header="Description" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                        </Grid>


                    </TabItem>

                </TabControl>
            </suki:GlassCard>

            <!--  Layer navigation !  -->
            <suki:GlassCard Margin="10" DockPanel.Dock="Right"
                            Padding="10"
                            Width="190"
                            IsEnabled="{Binding IsFileLoaded}">
                <Grid ColumnDefinitions="*"
                      RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,10"
                               HorizontalAlignment="Center"
                               Text="{Binding MaximumLayerString}"
                               TextAlignment="Center" />
                    <RepeatButton Grid.Row="1"
                                  HorizontalAlignment="Stretch"
                                  Content="{icon:MaterialIconExt Kind=MenuUp}"
                                  Command="{Binding GoNextLayerCommand}"
                                  HotKey="Ctrl + Up"
                                  Interval="100"
                                  IsEnabled="{Binding CanGoUp}"
                                  ToolTip.Tip="Navigate to up layer [Ctrl + Up]" />

                    <Grid Name="LayerNavigationSliderGrid"
                          Grid.Row="2"
                          ColumnDefinitions="*,20,40">
                        <Panel Name="LayerNavigationTooltipPanel"
                               Grid.Column="0"
                               Margin="{Binding LayerNavigationTooltipMargin}"
                               HorizontalAlignment="Stretch">
                            <suki:GlassCard Name="LayerNavigationTooltipBorder"
                                            VerticalAlignment="Top"
                                            Padding="10"
                                            Classes="LayerNavigationToolTip">
                                <TextBlock Text="{Binding ActualLayerTooltip}" />
                            </suki:GlassCard>
                        </Panel>

                        <Canvas Name="LayerNavigationIssuesCanvas"
                                Grid.Column="1"
                                Width="20"
                                Margin="0,15"
                                Classes="IssuesTrackerCanvas" />

                        <Slider Name="LayerSlider"
                                Grid.Column="2"
                                Margin="0,5"
                                HorizontalAlignment="Right"
                                IsSnapToTickEnabled="True"
                                LargeChange="10"
                                Maximum="{Binding SliderMaximumValue}"
                                Minimum="0"
                                Orientation="Vertical"
                                SmallChange="1"
                                TickFrequency="1"
                                TickPlacement="Outside"
                                Value="{Binding ActualLayerSlider}" />
                    </Grid>

                    <RepeatButton Grid.Row="3"
                                  HorizontalAlignment="Stretch"
                                  Content="{icon:MaterialIconExt Kind=MenuDown}"
                                  Command="{Binding GoPreviousLayerCommand}"
                                  HotKey="Ctrl + Down"
                                  Interval="100"
                                  IsEnabled="{Binding CanGoDown}"
                                  ToolTip.Tip="Navigate to down layer [Ctrl + Down]" />

                    <NumericUpDown Grid.Row="4"
                                   Margin="0,5"
                                   Maximum="{Binding SliderMaximumValue}"
                                   Minimum="0"
                                   Value="{Binding ActualLayer}" />

                    <Grid Grid.Row="5"
                          ColumnDefinitions="Auto,*,Auto"
                          RowDefinitions="*">
                        <Button Grid.Column="0"
                                Content="{icon:MaterialIconExt ChevronDoubleDown}"
                                Command="{Binding GoFirstLayerCommand}"
                                HotKey="Ctrl + Left"
                                IsEnabled="{Binding CanGoDown}"
                                ToolTip.Tip="Navigate to first layer [Ctrl + Left]" />

                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding MinimumLayerString}"
                                   TextAlignment="Center" />

                        <Button Grid.Column="2"
                                Content="{icon:MaterialIconExt ChevronDoubleUp}"
                                Command="{Binding GoLastLayerCommand}"
                                HotKey="Ctrl + Right"
                                IsEnabled="{Binding CanGoUp}"
                                ToolTip.Tip="Navigate to last layer [Ctrl + Right]" />
                    </Grid>

                    <StackPanel Grid.Row="6"
                                Margin="0,1,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="1">
                        <Button Command="{Binding GoMassLayerCommand}"
                                CommandParameter="SB"
                                Content="SB"
                                ToolTip.Tip="Navigate to the smallest bottom layer in mass" />

                        <Button Command="{Binding GoMassLayerCommand}"
                                CommandParameter="LB"
                                Content="LB"
                                ToolTip.Tip="Navigate to the largest bottom layer in mass" />

                        <Button Command="{Binding GoMassLayerCommand}"
                                CommandParameter="SN"
                                Content="SN"
                                ToolTip.Tip="Navigate to the smallest normal layer in mass" />

                        <Button Command="{Binding GoMassLayerCommand}"
                                CommandParameter="LN"
                                Content="LN"
                                ToolTip.Tip="Navigate to the largest normal layer in mass" />
                    </StackPanel>

                </Grid>
            </suki:GlassCard>


            <!--<StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
			<Button Name="zoomtofit">Zoom to fit</Button>
			<Button Name="center">Center image</Button>
			</StackPanel>-->
            <suki:GlassCard Margin="0,10"
                            Padding="10"
                            IsEnabled="{Binding IsFileLoaded}">
                <Grid RowDefinitions="Auto,*">
                    <TabControl Name="LayerPreviewTabControl"
                                Grid.Row="0"
                                SelectedIndex="{Binding LayerPreviewTabIndex}">
                        <TabControl.Template>
                            <ControlTemplate>
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabItem>
                            <TabItem.Header>
                                <icon:MaterialIconText Kind="Layers"
                                                       Text="Layers preview"
                                                       FontSize="16" />
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <icon:MaterialIconText VerticalAlignment="Center"
                                                       FontSize="16"
                                                       Kind="CubeOutline"
                                                       Text="3D Preview" />
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <icon:MaterialIconText VerticalAlignment="Center"
                                                       FontSize="16"
                                                       Kind="ViewSplitVertical"
                                                       Text="Split View" />
                            </TabItem.Header>
                        </TabItem>
                    </TabControl>

                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding LayerPreview2DWidth}" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{Binding LayerPreview3DWidth}" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: 2D Layer Preview -->
                        <Grid Grid.Column="0"
                              ColumnDefinitions="*"
                              RowDefinitions="Auto,*,Auto"
                              IsVisible="{Binding IsLayerPreviewVisible}">
                            <Grid Grid.Row="0"
                                  Grid.Column="0"
                                  Margin="0,5,0,5"
                                  ColumnDefinitions="*,Auto"
                                  IsEnabled="{Binding IsFileLoaded}"
                                  RowDefinitions="Auto">
                                <WrapPanel Grid.Row="0"
                                           Grid.Column="0"
                                           HorizontalAlignment="Left"
                                           Orientation="Horizontal"
                                           ItemSpacing="5"
                                           LineSpacing="5">
                                    <ToggleSplitButton VerticalAlignment="Stretch"
                                                       IsChecked="{Binding ShowLayerImageRotated}"
                                                       Content="{icon:MaterialIconTextExt Kind=Sync, Text='Rotate'}"
                                                       ToolTip.Tip="{Binding Source={x:Static ui:AppSettings.SystemCommandKeyString}, StringFormat='Auto rotate layer preview image at 90º (This can slow down the layer preview) [{0}+R]'}">
                                        <ToggleSplitButton.Flyout>
                                            <MenuFlyout>
                                                <MenuItem
                                                    Header="{icon:MaterialIconTextExt Kind=RotateRight, Text='90º Clockwise (CW)'}"
                                                    ToggleType="Radio"
                                                    GroupName="ShowLayerImageRotateDirection"
                                                    IsChecked="{Binding ShowLayerImageRotateCWDirection, Mode=TwoWay}" />
                                                <MenuItem
                                                    Header="{icon:MaterialIconTextExt Kind=RotateLeft, Text='90º Counter-clockwise (CCW)'}"
                                                    ToggleType="Radio"
                                                    GroupName="ShowLayerImageRotateDirection"
                                                    IsChecked="{Binding ShowLayerImageRotateCCWDirection, Mode=TwoWay}" />
                                            </MenuFlyout>
                                        </ToggleSplitButton.Flyout>
                                    </ToggleSplitButton>


                                    <ToggleSplitButton VerticalAlignment="Stretch"
                                                       IsChecked="{Binding ShowLayerImageFlipped}"
                                                       Content="{icon:MaterialIconTextExt Kind=FlipHorizontal, Text='Flip'}"
                                                       ToolTip.Tip="{Binding Source={x:Static ui:AppSettings.SystemCommandKeyString}, StringFormat='Auto flip layer preview image (This can slow down the layer preview) [{0}+F]'}">
                                        <ToggleSplitButton.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuItem Icon="{icon:MaterialIconExt Kind=FlipHorizontal}"
                                                          Header="Horizontally}"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerImageFlippedHorizontally, Mode=TwoWay}" />
                                                <MenuItem Icon="{icon:MaterialIconExt Kind=FlipVertical}"
                                                          Header="Vertically}"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerImageFlippedVertically, Mode=TwoWay}" />
                                            </MenuFlyout>
                                        </ToggleSplitButton.Flyout>
                                    </ToggleSplitButton>


                                    <ToggleSplitButton Margin="0,0,1,0"
                                                       VerticalAlignment="Stretch"
                                                       IsChecked="{Binding ShowLayerImageDifference, Mode=TwoWay}"
                                                       Content="{icon:MaterialIconTextExt Kind=Layers, Text='Difference'}"
                                                       ToolTip.Tip="Show layer differences or comparison modes between current, previous, and next layers.">
                                        <ToggleSplitButton.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuItem Header="Difference (highlight changes)"
                                                          ToggleType="Radio"
                                                          GroupName="LayerDiffModeGroup"
                                                          IsChecked="{Binding IsLayerDiffModeDifference, Mode=TwoWay}"
                                                          ToolTip.Tip="Show changes between previous, current, and next layer" />
                                                <MenuItem Header="Similarity (highlight common pixels)"
                                                          ToggleType="Radio"
                                                          GroupName="LayerDiffModeGroup"
                                                          IsChecked="{Binding IsLayerDiffModeSimilarity, Mode=TwoWay}"
                                                          ToolTip.Tip="Recolor pixels in common with previous and next layers" />
                                                <MenuItem Header="Onion skinning"
                                                          ToggleType="Radio"
                                                          GroupName="LayerDiffModeGroup"
                                                          IsChecked="{Binding IsLayerDiffModeOnionSkin, Mode=TwoWay}">
                                                    <MenuItem Header="3 Layers (-1, +1) [2 Ghost]"
                                                              ToggleType="Radio"
                                                              GroupName="OnionSkinLayerGroup"
                                                              IsChecked="{Binding IsLayerDiffModeOnionSkin3, Mode=TwoWay}"
                                                              ToolTip.Tip="3 Layers: Previous (-1), Current, Next (+1)" />
                                                    <MenuItem Header="4 Layers (-2, -1, +1) [3 Ghost]"
                                                              ToggleType="Radio"
                                                              GroupName="OnionSkinLayerGroup"
                                                              IsChecked="{Binding IsLayerDiffModeOnionSkin4, Mode=TwoWay}"
                                                              ToolTip.Tip="4 Layers: 2 foundation layers below, Current layer, 1 upcoming layer above" />
                                                    <MenuItem Header="5 Layers (-2 to +2) [4 Ghost]"
                                                              ToggleType="Radio"
                                                              GroupName="OnionSkinLayerGroup"
                                                              IsChecked="{Binding IsLayerDiffModeOnionSkin5, Mode=TwoWay}"
                                                              ToolTip.Tip="5 Layers (4 ghost): 2 foundation layers below, Current layer, 2 upcoming layers above" />
                                                    <MenuItem Header="6 Layers (-3 to +2) [5 Ghost]"
                                                              ToggleType="Radio"
                                                              GroupName="OnionSkinLayerGroup"
                                                              IsChecked="{Binding IsLayerDiffModeOnionSkin6, Mode=TwoWay}"
                                                              ToolTip.Tip="6 Layers (5 ghost): 3 foundation layers below, Current layer, 2 upcoming layers above" />
                                                </MenuItem>
                                            </MenuFlyout>
                                        </ToggleSplitButton.Flyout>
                                    </ToggleSplitButton>

                                    <ToggleSplitButton VerticalAlignment="Stretch"
                                                       IsChecked="{Binding ShowLayerImageIssues, Mode=TwoWay}"
                                                       Content="{icon:MaterialIconTextExt Kind=RadiationCircleOutline, Text='Issues'}"
                                                       ToolTip.Tip="Highlight Issues on current layer. Valid only if Issues are calculated.">
                                        <ToggleSplitButton.Flyout>
                                            <MenuFlyout>
                                                <MenuItem ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerImageCrosshairs, Mode=TwoWay}"
                                                          ToolTip.Tip="Show crosshairs for selected issues on the current layer"
                                                          Icon="{icon:MaterialIconExt Crosshairs}"
                                                          Header="Crosshairs" />
                                            </MenuFlyout>
                                        </ToggleSplitButton.Flyout>
                                    </ToggleSplitButton>


                                    <DropDownButton Name="LayerPreviewOutlineButton"
                                                    Margin="1,0,2,0"
                                                    VerticalAlignment="Stretch"
                                                    Content="{icon:MaterialIconTextExt Kind=VectorUnion, Text='Outline'}"
                                                    ToolTip.Tip="Click to access the various outlines.">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuItem Header="Print volume boundary"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerOutlinePrintVolumeBoundary, Mode=TwoWay}" />
                                                <MenuItem Header="Layer boundary"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerOutlineLayerBoundary, Mode=TwoWay}" />
                                                <MenuItem Header="Blob boundary"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerOutlineContourBoundary, Mode=TwoWay}" />
                                                <MenuItem Header="Enclosing circles"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerOutlineEnclosingCircles, Mode=TwoWay}" />
                                                <MenuItem Header="Hollow areas"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerOutlineHollowAreas, Mode=TwoWay}" />
                                                <MenuItem Header="Centroids"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerOutlineCentroids, Mode=TwoWay}" />
                                                <MenuItem Header="Triangulate"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerOutlineTriangulate, Mode=TwoWay}" />
                                                <MenuItem Header="Edge detection"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerOutlineEdgeDetection, Mode=TwoWay}">
                                                    <MenuItem.IsEnabled>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="!ShowLayerOutlineDistanceDetection" />
                                                            <Binding Path="!ShowLayerOutlineSkeletonize" />
                                                        </MultiBinding>
                                                    </MenuItem.IsEnabled>
                                                </MenuItem>
                                                <MenuItem Header="Distance detection"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerOutlineDistanceDetection, Mode=TwoWay}"
                                                          ToolTip.Tip="Calculates the distance to the closest zero pixel for each pixel">
                                                    <MenuItem.IsEnabled>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="!ShowLayerOutlineEdgeDetection" />
                                                            <Binding Path="!ShowLayerOutlineSkeletonize" />
                                                        </MultiBinding>
                                                    </MenuItem.IsEnabled>
                                                </MenuItem>
                                                <MenuItem Header="Skeletonize"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding ShowLayerOutlineSkeletonize, Mode=TwoWay}">
                                                    <MenuItem.IsEnabled>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="!ShowLayerOutlineEdgeDetection" />
                                                            <Binding Path="!ShowLayerOutlineDistanceDetection" />
                                                        </MultiBinding>
                                                    </MenuItem.IsEnabled>
                                                </MenuItem>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>


                                    <ToggleButton Margin="-1,0,0,0"
                                                  VerticalAlignment="Stretch"
                                                  HotKey="{OnPlatform Ctrl+E,
											 macOS=⌘+E}"
                                                  Content="{icon:MaterialIconTextExt Kind=RulerSquareCompass, Text='Pixel Editor'}"
                                                  IsChecked="{Binding IsPixelEditorActive}"
                                                  ToolTip.Tip="{Binding Source={x:Static ui:AppSettings.SystemCommandKeyString}, StringFormat='Edit layer image: Draw pixels, add supports and/or drain holes. [{0}+E]'}" />
                                    <ToggleButton Margin="1,0,1,0"
                                                  VerticalAlignment="Stretch"
                                                  HotKey="M"
                                                  Content="{icon:MaterialIconExt Kind=Ruler, Classes='Fill'}"
                                                  IsChecked="{Binding IsMeasureMode2D, Mode=TwoWay}"
                                                  ToolTip.Tip="Measure distance and wall thickness on 2D slice [M]. Click two points to measure." />
                                    <ToggleButton Margin="1,0,1,0"
                                                  VerticalAlignment="Stretch"
                                                  HotKey="A"
                                                  Content="{icon:MaterialIconExt Kind=ChartAreaspline, Classes='Fill'}"
                                                  IsChecked="{Binding Show2DPeelCurve, Mode=TwoWay}"
                                                  ToolTip.Tip="Toggle layer cross-section area and peel force curve HUD [A]" />
                                </WrapPanel>


                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Spacing="5"
                                            Orientation="Horizontal">
                                    <DropDownButton Name="LayerActionsButton"
                                                    VerticalAlignment="Stretch"
                                                    VerticalContentAlignment="Center"
                                                    Content="{icon:MaterialIconTextExt Kind=LayersEdit, Text='Actions'}">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout ItemsSource="{Binding LayerActionsMenu}"
                                                        Placement="Bottom" />
                                        </DropDownButton.Flyout>
                                    </DropDownButton>

                                    <Button VerticalAlignment="Stretch"
                                            Command="{Binding ShowLayerCommand}"
                                            HotKey="F5"
                                            Content="{icon:MaterialIconExt Kind=Sync}"
                                            ToolTip.Tip="Refresh current layer [F5]" />


                                    <SplitButton VerticalAlignment="Stretch"
                                                 VerticalContentAlignment="Center"
                                                 Command="{Binding SaveCurrentLayerImageCommand}"
                                                 Content="{icon:MaterialIconExt Kind=ContentSave}"
                                                 ToolTip.Tip="Save layer image to a file">
                                        <SplitButton.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Icon="{icon:MaterialIconExt Kind=Group}"
                                                          Command="{Binding SaveCurrentROIImageCommand}"
                                                          Header="Save the selected region (ROI)" />
                                            </MenuFlyout>
                                        </SplitButton.Flyout>
                                    </SplitButton>


                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    BorderBrush="{DynamicResource LightBackground}"
                                    BorderThickness="5">
                                <Grid>
                                    <uvtava:AdvancedImageBox Name="LayerImageBox"
                                                             ConstrainZoomOutToFitLevel="True"
                                                             GridCellSize="15"
                                                             PanDownKey="S"
                                                             PanLeftKey="A"
                                                             PanRightKey="D"
                                                             PanUpKey="W"
                                                             PanWithArrows="False"
                                                             ShowGrid="{Binding Settings.LayerPreview.ShowBackgroundGrid}"
                                                             ScrollViewer.AllowAutoHide="False"
                                                             ZoomTo100KeyGestures="{x:Null}"
                                                             ZoomToFitKeyGestures="{x:Null}" />

                                    <!-- 2D Caliper Measurement Overlay Lines and Dimension Badges -->
                                    <controls:LayerMeasure2DOverlayControl ImageBox="{Binding #LayerImageBox}"
                                                                           IsActive="{Binding IsMeasureMode2D}"
                                                                           StartPoint="{Binding Measure2DStartPoint}"
                                                                           EndPoint="{Binding Measure2DEndPoint}"
                                                                           CursorPoint="{Binding Measure2DCursorPoint}"
                                                                           PixelPitchX="{Binding PixelPitchX}"
                                                                           PixelPitchY="{Binding PixelPitchY}"
                                                                           IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <!-- 2D Measurement Floating HUD -->
                            <suki:GlassCard Grid.Row="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="16,16,0,0"
                                            Padding="10,8"
                                            IsVisible="{Binding IsMeasureMode2D}">
                                <StackPanel Spacing="6" Width="260">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left" VerticalAlignment="Center">
                                            <icon:MaterialIcon Kind="Ruler" Width="18" Height="18" Foreground="#29B6F6" />
                                            <TextBlock Text="2D Measurement" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right"
                                                Command="{Binding ToggleMeasureMode2DCommand}"
                                                Classes="Basic"
                                                Padding="4"
                                                Width="24" Height="24"
                                                ToolTip.Tip="Close measurement [Esc]">
                                            <icon:MaterialIcon Kind="Close" Width="14" Height="14" />
                                        </Button>
                                        <Border />
                                    </DockPanel>

                                    <TextBlock Text="{Binding Measure2DStatusText}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="#81D4FA"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding Measure2DDetailText}"
                                               FontSize="11"
                                               Opacity="0.85"
                                               FontFamily="Consolas, Cascadia Code, monospace"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasMeasure2DPoints}" />

                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button Content="Clear"
                                                Classes="Outlined"
                                                Padding="8,3"
                                                FontSize="11"
                                                Command="{Binding ClearMeasure2DCommand}"
                                                IsEnabled="{Binding HasMeasure2DPoints}"
                                                ToolTip.Tip="Clear measured points [Esc]" />
                                        <TextBlock Text="Click: Set A / B  |  R-Click: Clear"
                                                   FontSize="10"
                                                   Opacity="0.6"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </suki:GlassCard>

                            <!-- 2D Peel Force & Area Curve HUD -->
                            <Border Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,16,16"
                                    CornerRadius="8"
                                    Background="#D81E1E2E"
                                    BorderBrush="#3B4252"
                                    BorderThickness="1"
                                    MinWidth="340"
                                    MaxWidth="480"
                                    Height="150"
                                    IsVisible="{Binding Show2DPeelCurve}">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid Grid.Row="0" Margin="10,6,6,2" ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <icon:MaterialIcon Kind="ChartAreaspline" Width="14" Height="14" Foreground="#89B4FA" />
                                            <TextBlock Text="Cross-Section &amp; Peel Curve" FontSize="11" FontWeight="SemiBold" Foreground="#CDD6F4" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Classes="Basic"
                                                Padding="2"
                                                Width="22" Height="22"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding Toggle2DPeelCurveCommand}"
                                                ToolTip.Tip="Close Peel Force Curve [A]">
                                            <icon:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="#8B949E" />
                                        </Button>
                                    </Grid>
                                    <controls:LayerAreaPeelCurveControl Grid.Row="1"
                                            Margin="6,0,6,6"
                                            LayerAreas="{Binding LayerAreas}"
                                            PeelSpikes="{Binding PeelSpikes}"
                                            LayerLiftSpeeds="{Binding LayerLiftSpeeds}"
                                            LayerLiftSpeeds2="{Binding LayerLiftSpeeds2}"
                                            LayerLiftHeights="{Binding LayerLiftHeights}"
                                            LayerLiftHeights2="{Binding LayerLiftHeights2}"
                                            CurrentLayer="{Binding ActualLayer}"
                                            MaxArea="{Binding MaxLayerArea}"
                                            PeakLayer="{Binding PeakLayerIndex}"
                                            HaveTiltingVat="{Binding SlicerFile.HaveTiltingVat}"
                                            LayerSelectedCommand="{Binding SelectLayerCommand}" />
                                </Grid>
                            </Border>

                            <Canvas Grid.Row="1"
                                    Margin="20"
                                    IsVisible="{Binding IsTooltipOverlayVisible}">
                                <Border Padding="10"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Border.Background>
                                        <SolidColorBrush
                                            Color="{Binding Settings.LayerPreview.TooltipOverlayBackgroundBrush}" />
                                    </Border.Background>
                                    <TextBlock Foreground="Black"
                                               Text="{Binding TooltipOverlayText}" />
                                </Border>
                            </Canvas>


                            <Grid Grid.Row="2"
                                  Margin="5"
                                  ColumnDefinitions="4*,2*"
                                  IsEnabled="{Binding IsFileLoaded}"
                                  RowDefinitions="Auto">
                                <WrapPanel Grid.Column="0"
                                           Orientation="Horizontal"
                                           ItemSpacing="5" LineSpacing="5">
                                    <Button
                                        Content="{icon:MaterialIconTextExt Kind=GoogleDownasaur, Text={Binding LayerPixelCountStr}}"
                                        ToolTip.Tip="Number of pixels to cure on this layer image and the percentage of them against total lcd pixels and the total cured millimeters." />

                                    <Button Command="{Binding ZoomToFitPrintVolumeCommand}"
                                            Content="{icon:MaterialIconTextExt Kind=SquareOutline, Text={Binding LayerBoundsStr}}"
                                            ToolTip.Tip="Object volume bounds for current layer, position and size in pixels and millimeters. &#x0a;Click: go to region" />

                                    <SplitButton Command="{Binding ROIClickCommand}"
                                                 IsEnabled="{Binding IsFileLoaded}"
                                                 Content="{icon:MaterialIconTextExt Kind=SquareCircleOutline, Text={Binding LayerROIStr}}"
                                                 ToolTip.Tip="Region of interest selection over layer. &#x0a;(NS): Not selected &#x0a;Click: go to region &#x0a;ESC: Clear ROI &amp; Masks | ESC + Shift: Clear ROI">
                                        <SplitButton.Flyout>
                                            <MenuFlyout Placement="Top">
                                                <MenuItem Command="{Binding SelectLayerPositiveAreasMaskCommand}"
                                                          Header="Mask: Select layer positive areas" />
                                                <MenuItem Command="{Binding SelectLayerHollowAreasMaskCommand}"
                                                          Header="Mask: Select layer hollow areas" />
                                                <Separator />
                                                <MenuItem Command="{Binding SelectModelVolumeRoiCommand}"
                                                          Header="ROI: Select model volume" />
                                                <MenuItem Command="{Binding SelectLayerVolumeRoiCommand}"
                                                          Header="ROI: Select layer volume" />
                                                <Separator />
                                                <MenuItem Command="{Binding ClearMaskCommand}"
                                                          Header="Clear Mask" />
                                                <MenuItem Command="{Binding ClearROICommand}"
                                                          Header="Clear ROI" />
                                            </MenuFlyout>
                                        </SplitButton.Flyout>
                                    </SplitButton>

                                </WrapPanel>

                                <WrapPanel Grid.Column="1"
                                           ItemSpacing="5" LineSpacing="5"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Orientation="Horizontal">
                                    <Button Command="{Binding LayerPixelPickerClickedCommand}"
                                            IsEnabled="{Binding LayerPixelPicker.IsSet}"
                                            Content="{icon:MaterialIconTextExt Kind=MapMarkerOutline, Text={Binding LayerPixelPicker}}"
                                            ToolTip.Tip="Pixel picker: &#x0a;Use CONTROL and over a pixel to get his position and brightness. &#x0a;Click: Center at position" />

                                    <Button Command="{Binding ZoomToNormalCommand}"
                                            Content="{icon:MaterialIconTextExt Kind=MagnifyExpand, Text={Binding LayerZoomStr}}"
                                            ToolTip.Tip="{Binding Source={x:Static ui:AppSettings.SystemCommandKeyString}, StringFormat='Layer image zoom level, use mouse scroll to zoom in/out into image. &#x0a;Click to set zoom to 100% &#x0a;Shift+Click to set zoom to defined value &#x0a;{0}+0 OR double right click to scale to fit'}" />

                                    <Button Command="{Binding ZoomToFitSimpleCommand}"
                                            Content="{icon:MaterialIconTextExt Kind=MagnifyScan, Text={Binding LayerResolutionStr}}"
                                            ToolTip.Tip="{Binding Source={x:Static ui:AppSettings.SystemCommandKeyString}, StringFormat='Layer Resolution and display size. &#x0a;Click: Zoom to fit [{0}+Alt+0]'}" />

                                    <TextBlock Margin="5,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding ShowLayerRenderMs, StringFormat={}{0}ms}"
                                               ToolTip.Tip="Layer preview computation time." />
                                </WrapPanel>
                            </Grid>
                        </Grid>

                        <!-- Column 1: Draggable Splitter (Dual View) -->
                        <GridSplitter Grid.Column="1"
                                      Width="6"
                                      Background="{DynamicResource SukiBorderBrush}"
                                      IsVisible="{Binding IsDualPreviewTabActive}"
                                      ResizeDirection="Columns" />

                        <!-- Column 2: 3D Preview -->
                        <Grid Grid.Column="2"
                              RowDefinitions="Auto,*,Auto,Auto"
                              RowSpacing="5"
                              IsVisible="{Binding Is3DPreviewVisible}">
                            <Grid Grid.Row="0"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="5">
                                <WrapPanel Grid.Row="0"
                                           Grid.Column="0"
                                           ItemSpacing="5"
                                           LineSpacing="5">
                                    <SplitButton Command="{Binding RebuildLayer3DPreviewCommand}"
                                            Content="{icon:MaterialIconTextExt Kind=Refresh, Text='{Binding Layer3DBuildButtonText}'}"
                                            IsEnabled="{Binding CanBuildLayer3DPreview}"
                                            VerticalAlignment="Stretch"
                                            ToolTip.Tip="Generate and cache a 3D model from the current slices. (Right-click for options)">
                                        <SplitButton.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Build 3D on file open"
                                                          ToggleType="CheckBox"
                                                          IsChecked="{Binding Settings.Layer3DPreview.Build3DAfterFileOpen, Mode=TwoWay}" />
                                            </MenuFlyout>
                                        </SplitButton.Flyout>
                                    </SplitButton>

                                    <ComboBox Width="130"
                                              ItemsSource="{Binding Layer3DQualityOptions}"
                                              SelectedItem="{Binding SelectedLayer3DQuality}"
                                              VerticalAlignment="Stretch"
                                              ToolTip.Tip="Preview detail. Higher detail takes more time and memory." />

                                    <ComboBox Width="140"
                                              IsEnabled="{Binding HasLayer3DMesh}"
                                              ItemsSource="{Binding Layer3DRenderModeOptions}"
                                              SelectedItem="{Binding SelectedLayer3DRenderMode}"
                                              VerticalAlignment="Stretch"
                                              ToolTip.Tip="Switch between [S]olid, [X]-Ray, and [W]ireframe views without rebuilding the model." />

                                    <ComboBox Width="140"
                                              IsEnabled="{Binding HasLayer3DMesh}"
                                              ItemsSource="{Binding Layer3DLightingModeOptions}"
                                              SelectedItem="{Binding SelectedLayer3DLightingMode}"
                                              VerticalAlignment="Stretch"
                                              ToolTip.Tip="Lighting mode [L]:&#x0a;Camera follows the view&#x0a;Studio uses a fixed light&#x0a;Flat disables shading" />

                                    <ComboBox Width="175"
                                              IsEnabled="{Binding HasLayer3DMesh}"
                                              ItemsSource="{Binding Layer3DColorModeOptions}"
                                              SelectedItem="{Binding SelectedLayer3DColorMode}"
                                              VerticalAlignment="Stretch"
                                              ToolTip.Tip="Color mode [H]:&#x0a;Solid: resin color&#x0a;Overhang heatmap: highlights steep overhangs&#x0a;Layer zones: highlights bottom and transition layers&#x0a;Peel force &amp; area risk: cross-section area &amp; delamination spikes&#x0a;Bed adhesion footprint: build plate contact &amp; stability" />

                                    <ComboBox Width="120"
                                              IsEnabled="{Binding Layer3DClipToCurrentLayer}"
                                              ItemsSource="{Binding Layer3DClipModeOptions}"
                                              SelectedItem="{Binding SelectedLayer3DClipMode}"
                                              VerticalAlignment="Stretch"
                                              ToolTip.Tip="Clipping direction: Clip top, Clip bottom (Inverted) [Shift + C], or Slab band." />


                                    <ToggleButton
                                        IsChecked="{Binding Settings.Layer3DPreview.UseOthographicProjection}"
                                        IsEnabled="{Binding HasLayer3DMesh}"
                                        Content="{icon:MaterialIconExt Kind=CameraEnhanceOutline, Classes='Fill'}"
                                        VerticalAlignment="Stretch"
                                        ToolTip.Tip="Toggle on for a orthographic [p]rojection otherwise default is perspective projection." />

                                    <ToggleButton Content="{icon:MaterialIconExt LayersSearchOutline, Classes='Fill'}"
                                                  IsChecked="{Binding Layer3DClipToCurrentLayer}"
                                                  IsEnabled="{Binding HasLayer3DMesh}"
                                                  VerticalAlignment="Stretch"
                                                  ToolTip.Tip="Clip the model at the selected layer. [C]" />

                                    <ToggleButton Content="{icon:MaterialIconExt Ghost, Classes='Fill'}"
                                                  IsChecked="{Binding Settings.Layer3DPreview.GhostClippedModel}"
                                                  IsEnabled="{Binding Layer3DClipToCurrentLayer}"
                                                  VerticalAlignment="Stretch"
                                                  ToolTip.Tip="Show faint ghost silhouette of clipped model [O]." />

                                    <Button Command="{Binding TogglePrintSimulationCommand}"
                                            IsEnabled="{Binding HasLayer3DMesh}"
                                            VerticalAlignment="Stretch"
                                            ToolTip.Tip="Play / Pause Print Simulation [Shift+Space]">
                                        <icon:MaterialIcon Kind="{Binding PrintSimulationPlayIcon}" Classes="Fill" />
                                    </Button>

                                    <Button Command="{Binding CyclePrintSimulationSpeedCommand}"
                                            IsEnabled="{Binding HasLayer3DMesh}"
                                            VerticalAlignment="Stretch"
                                            Padding="6,0"
                                            ToolTip.Tip="Cycle Simulation Speed: 1x, 2x, 5x, 10x, 25x, 50x">
                                        <TextBlock Text="{Binding PrintSimulationSpeedText}" FontWeight="Bold"
                                                   FontSize="11" VerticalAlignment="Center" />
                                    </Button>

                                    <ToggleButton Content="{icon:MaterialIconExt Kind=ChartAreaspline, Classes='Fill'}"
                                                  IsChecked="{Binding Settings.Layer3DPreview.ShowPeelCurve, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasLayer3DMesh}"
                                                  VerticalAlignment="Stretch"
                                                  ToolTip.Tip="Toggle Cross-Section Area &amp; Peel Force Curve HUD [A]." />

                                    <ToggleButton Content="{icon:MaterialIconExt Grid, Classes='Fill'}"
                                                  IsChecked="{Binding Settings.Layer3DPreview.ShowBuildPlateGrid, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasLayer3DMesh}"
                                                  VerticalAlignment="Stretch"
                                                  ToolTip.Tip="Toggle build plate grid and printable volume wireframe [G]." />

                                    <ToggleButton IsChecked="{Binding Settings.Layer3DPreview.ShowLayerIssues, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasLayer3DMesh}"
                                                  Content="{icon:MaterialIconExt Kind=RadiationCircleOutline, Classes='Fill'}"
                                                  VerticalAlignment="Stretch"
                                                  ToolTip.Tip="Highlight Issues on 3D model [I]." />

                                    <ToggleButton IsChecked="{Binding Settings.Layer3DPreview.ShowBoundingBox, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasLayer3DMesh}"
                                                  Content="{icon:MaterialIconExt Kind=CubeOutline, Classes='Fill'}"
                                                  VerticalAlignment="Stretch"
                                                  ToolTip.Tip="Toggle model bounding box and dimensions [B]." />

                                    <ToggleButton IsChecked="{Binding Settings.Layer3DPreview.ShowModelStats, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasLayer3DMesh}"
                                                  Content="{icon:MaterialIconExt Kind=ScaleBalance, Classes='Fill'}"
                                                  VerticalAlignment="Stretch"
                                                  ToolTip.Tip="Toggle model volume, weight &amp; resin cost HUD [V]." />

                                    <ToggleButton IsChecked="{Binding Settings.Layer3DPreview.ShowCenterOfMass, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasLayer3DMesh}"
                                                  Content="{icon:MaterialIconExt Kind=CrosshairsGps, Classes='Fill'}"
                                                  VerticalAlignment="Stretch"
                                                  ToolTip.Tip="Toggle Center of Mass and first-layer contact stability [K]." />

                                    <ToggleButton IsChecked="{Binding Settings.Layer3DPreview.ShowMeasure, Mode=TwoWay}"
                                                  IsEnabled="{Binding HasLayer3DMesh}"
                                                  Content="{icon:MaterialIconExt Kind=Ruler, Classes='Fill'}"
                                                  VerticalAlignment="Stretch"
                                                  ToolTip.Tip="Measure tool. Click two points on the 3D model. [M]" />

                                    <!-- <ToggleButton IsChecked="{Binding #LayerModel3DView.IsTurntableActive}" -->
                                    <!--               IsEnabled="{Binding HasLayer3DMesh}" -->
                                    <!--               Content="{icon:MaterialIconExt Kind=Rotate360, Classes='Fill'}" -->
                                    <!--               VerticalAlignment="Stretch" -->
                                    <!--               ToolTip.Tip="Turntable / auto-rotate view [T or Space]"/> -->

                                    <TextBlock VerticalAlignment="Center"
                                               Classes="Warning"
                                               IsVisible="{Binding IsLayer3DPreviewStale}"
                                               Text="Cached preview is stale" />
                                </WrapPanel>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="5">
                                    <DropDownButton IsEnabled="{Binding HasLayer3DMesh}"
                                                    VerticalAlignment="Stretch"
                                                    ToolTip.Tip="Export options: Snapshot, 3D Mesh (STL/OBJ), or Turntable Animation (GIF)">
                                        <icon:MaterialIcon Kind="Export" Classes="Fill" />
                                        <DropDownButton.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                <MenuItem Header="Copy Snapshot to Clipboard (Ctrl+C)"
                                                          Command="{Binding CopyLayer3DSnapshotToClipboardCommand}"
                                                          Icon="{icon:MaterialIconExt ContentCopy}" />
                                                <MenuItem Header="Save Snapshot to File (F12)"
                                                          Command="{Binding SaveLayer3DSnapshotToFileCommand}"
                                                          Icon="{icon:MaterialIconExt ContentSave}" />
                                                <MenuItem Header="Export Current Cross-Section to PNG"
                                                          Command="{Binding ExportCrossSectionToPngCommand}"
                                                          Icon="{icon:MaterialIconExt ContentCut}" />
                                                <Separator />
                                                <MenuItem Header="Export Full Mesh to STL"
                                                          Command="{Binding ExportMeshToStlCommand}"
                                                          CommandParameter="{x:False}"
                                                          Icon="{icon:MaterialIconExt CubeOutline}" />
                                                <MenuItem Header="Export Clipped Mesh to STL"
                                                          Command="{Binding ExportMeshToStlCommand}"
                                                          CommandParameter="{x:True}"
                                                          Icon="{icon:MaterialIconExt ContentCut}" />
                                                <Separator />
                                                <MenuItem Header="Export Full Mesh to OBJ"
                                                          Command="{Binding ExportMeshToObjCommand}"
                                                          CommandParameter="{x:False}"
                                                          Icon="{icon:MaterialIconExt FileDocumentOutline}" />
                                                <MenuItem Header="Export Clipped Mesh to OBJ"
                                                          Command="{Binding ExportMeshToObjCommand}"
                                                          CommandParameter="{x:True}"
                                                          Icon="{icon:MaterialIconExt ContentCut}" />
                                                <Separator />
                                                <MenuItem Header="Export 360° Turntable Animation (GIF)"
                                                          Command="{Binding ExportTurntableAnimationCommand}"
                                                          Icon="{icon:MaterialIconExt Filmstrip}" />
                                                <Separator />
                                                <MenuItem Header="Copy Model Estimates to Clipboard"
                                                          Command="{Binding CopyLayer3DModelStatsToClipboardCommand}"
                                                          Icon="{icon:MaterialIconExt Kind=ClipboardTextOutline}" />
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                    
                                    <icon:MaterialIcon Kind="InformationOutline"
                                                       Background="Transparent"
                                                       VerticalAlignment="Stretch"
                                                       FontSize="28"
                                                       ToolTip.Tip="Views:&#x0a;» (S)olid: shaded opaque model&#x0a;» (X)-Ray: translucent model with internal geometry visible&#x0a;» (W)ireframe: visible optimized mesh edges&#x0a;&#x0a;Mouse:&#x0a;» Left-click drag to orbit&#x0a;» Right/middle-click drag to pan&#x0a;» Click model: Click-to-Layer (jump to slice)&#x0a;» Wheel to zoom, double-click to reset&#x0a;&#x0a;Keyboard:&#x0a;» 1-6: front, back, left, right, top, bottom view&#x0a;» 0 or Home: reset the camera&#x0a;» F: fit model to view&#x0a;» Arrows: orbit in steps&#x0a;» + and -: zoom in and out&#x0a;» C: toggle clip to current layer&#x0a;» Shift+C: invert clipping&#x0a;» G: toggle build plate grid&#x0a;» H: cycle overhang heatmap / layer zones&#x0a;» O: toggle ghost silhouette of clipped model&#x0a;» P: toggle perspective/orthographic&#x0a;» B: toggle model bounding box and dimensions&#x0a;» V: toggle model volume, weight &amp; cost&#x0a;» K: toggle center of mass &amp; contact&#x0a;» M: toggle measurement tool (Esc to clear/exit)&#x0a;» L: cycle lighting mode (Camera / Studio / Flat)&#x0a;» Shift+X: cycle cutaway cross-section plane&#x0a;» Ctrl+C / F12: snapshot to clipboard / file&#x0a;» T or Space: toggle turntable auto-rotate" />
                                </StackPanel>
                            </Grid>


                            <Border Grid.Row="1"
                                    BorderBrush="{DynamicResource LightBackground}"
                                    BorderThickness="5"
                                    ClipToBounds="True">
                                <Grid>
                                    <controls:LayerModel3DView Name="LayerModel3DView"
                                                               BackgroundColor="{Binding Settings.Layer3DPreview.BackgroundBrush}"
                                                               IsOrthographic="{Binding Settings.Layer3DPreview.UseOthographicProjection}"
                                                               LightingMode="{Binding Layer3DLightingMode}"
                                                               RenderMode="{Binding Layer3DRenderMode}"
                                                               ColorMode="{Binding Layer3DColorMode}"
                                                               ClipMode="{Binding Layer3DClipMode}"
                                                               ShowBuildPlateGrid="{Binding Settings.Layer3DPreview.ShowBuildPlateGrid, Mode=TwoWay}"
                                                               ShowLayerIssues="{Binding Settings.Layer3DPreview.ShowLayerIssues, Mode=TwoWay}"
                                                               GhostClippedModel="{Binding Settings.Layer3DPreview.GhostClippedModel, Mode=TwoWay}"
                                                               ShowBoundingBox="{Binding Settings.Layer3DPreview.ShowBoundingBox, Mode=TwoWay}"
                                                               ShowModelStats="{Binding Settings.Layer3DPreview.ShowModelStats, Mode=TwoWay}"
                                                               ShowCenterOfMass="{Binding Settings.Layer3DPreview.ShowCenterOfMass, Mode=TwoWay}"
                                                               ShowPeelCurve="{Binding Settings.Layer3DPreview.ShowPeelCurve, Mode=TwoWay}"
                                                               IsMeasureMode="{Binding Settings.Layer3DPreview.ShowMeasure, Mode=TwoWay}"
                                                               CutawayAxis="{Binding Settings.Layer3DPreview.CutawayAxis, Mode=TwoWay}"
                                                               CutawayPosition="{Binding Settings.Layer3DPreview.CutawayPosition, Mode=TwoWay}"
                                                               CutawayInvert="{Binding Settings.Layer3DPreview.CutawayInvert, Mode=TwoWay}"
                                                               SlabThickness="{Binding Settings.Layer3DPreview.SlabThicknessMm, Mode=TwoWay}"
                                                               VoxelColor="{Binding Settings.Layer3DPreview.VoxelBrush}" />

                                    <controls:LayerModelOrientationCube Name="LayerModelOrientationCube"
                                                                        Width="128"
                                                                        Height="128"
                                                                        Margin="12"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        IsTurntableActive="{Binding #LayerModel3DView.IsTurntableActive}"
                                                                        ToolTip.Tip="ViewCube: Drag to orbit. Click face, edge, corner, arrows, or Home icon.">
                                        <controls:LayerModelOrientationCube.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="HasLayer3DMesh" />
                                                <Binding Path="IsLayer3DRendererAvailable" />
                                            </MultiBinding>
                                        </controls:LayerModelOrientationCube.IsVisible>
                                    </controls:LayerModelOrientationCube>

                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="560"
                                            Padding="20"
                                            Background="#CC20242C"
                                            CornerRadius="6"
                                            IsHitTestVisible="False"
                                            IsVisible="{Binding ShowLayer3DStatusOverlay}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   Text="{Binding Layer3DStatus}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <!-- Top-Left HUDs: Model Dimensions and Estimates -->
                                    <StackPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="14"
                                                Spacing="8">
                                        <!-- Model Dimensions & Bounding Box HUD Overlay -->
                                        <Border Padding="10,6"
                                                Background="#E0161920"
                                                BorderBrush="#00D2FF"
                                                BorderThickness="1.5"
                                                CornerRadius="6">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="HasLayer3DMesh" />
                                                    <Binding Path="#LayerModel3DView.ShowBoundingBox" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <icon:MaterialIcon Grid.Column="0"
                                                                   Kind="CubeOutline"
                                                                   Width="22"
                                                                   Height="22"
                                                                   Foreground="#00D2FF"
                                                                   VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#A0A8B8"
                                                               Text="BOUNDING BOX (X × Y × Z)" />
                                                    <TextBlock FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               Text="{Binding #LayerModel3DView.ModelDimensionsText}" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Margin="6,0,0,0"
                                                        Padding="4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ToggleBoundingBoxCommand}"
                                                        ToolTip.Tip="Close Bounding Box [B]">
                                                    <icon:MaterialIcon Kind="Close" Width="16" Height="16"
                                                                       Foreground="#8B949E" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Model Volume, Weight & Resin Cost HUD Overlay -->
                                        <Border Padding="10,6"
                                                Background="#E0161920"
                                                BorderBrush="#FFB300"
                                                BorderThickness="1.5"
                                                CornerRadius="6">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="HasLayer3DMesh" />
                                                    <Binding Path="#LayerModel3DView.ShowModelStats" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <icon:MaterialIcon Grid.Column="0"
                                                                   Kind="ScaleBalance"
                                                                   Width="22"
                                                                   Height="22"
                                                                   Foreground="#FFB300"
                                                                   VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#A0A8B8"
                                                               Text="MODEL ESTIMATES (VOLUME / WEIGHT / COST)" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               Text="{Binding #LayerModel3DView.ModelStatsText}" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Margin="6,0,0,0"
                                                        Padding="4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ToggleModelStatsCommand}"
                                                        ToolTip.Tip="Close Model Estimates [V]">
                                                    <icon:MaterialIcon Kind="Close" Width="16" Height="16"
                                                                       Foreground="#8B949E" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Bottom-Left HUDs: Center of Mass and Measure Tool -->
                                    <StackPanel HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Margin="14"
                                                Spacing="8">
                                        <!-- Center of Mass & First-Layer Contact HUD Overlay -->
                                        <Border Padding="10,6"
                                                Background="#E0161920"
                                                BorderBrush="#FFD700"
                                                BorderThickness="1.5"
                                                CornerRadius="6">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="HasLayer3DMesh" />
                                                    <Binding Path="#LayerModel3DView.ShowCenterOfMass" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <icon:MaterialIcon Grid.Column="0"
                                                                   Kind="CrosshairsGps"
                                                                   Width="22"
                                                                   Height="22"
                                                                   Foreground="#FFD700"
                                                                   VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#A0A8B8"
                                                               Text="CENTER OF MASS &amp; FIRST-LAYER CONTACT" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               Text="{Binding #LayerModel3DView.CenterOfMassText}" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Margin="6,0,0,0"
                                                        Padding="4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ToggleCenterOfMassCommand}"
                                                        ToolTip.Tip="Close Center of Mass [K]">
                                                    <icon:MaterialIcon Kind="Close" Width="16" Height="16"
                                                                       Foreground="#8B949E" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Measure tool HUD overlay -->
                                        <Border Padding="12,8"
                                                Background="#E0161920"
                                                BorderBrush="#FF5FA2"
                                                BorderThickness="1.5"
                                                CornerRadius="6">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="HasLayer3DMesh" />
                                                    <Binding Path="#LayerModel3DView.IsMeasureMode" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <icon:MaterialIcon Grid.Column="0"
                                                                   Kind="Ruler"
                                                                   Width="20"
                                                                   Height="20"
                                                                   Foreground="#FF5FA2"
                                                                   VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FFA8D0"
                                                               Text="DISTANCE MEASUREMENT" />
                                                    <TextBlock FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               Text="{Binding #LayerModel3DView.MeasureDistanceText}" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Margin="6,0,0,0"
                                                        Padding="4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding ToggleMeasureModeCommand}"
                                                        ToolTip.Tip="Close Measure Tool [M]">
                                                    <icon:MaterialIcon Kind="Close" Width="16" Height="16"
                                                                       Foreground="#8B949E" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Universal 3D Issue Navigator HUD Overlay -->
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,14,0,0"
                                            Padding="12,6"
                                            Background="#E0161920"
                                            BorderBrush="{Binding Current3DIssueBorderColor}"
                                            BorderThickness="1.5"
                                            CornerRadius="6"
                                            IsVisible="{Binding Has3DIssues}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <icon:MaterialIcon Kind="{Binding Current3DIssueIcon}"
                                                               Foreground="{Binding Current3DIssueBorderColor}"
                                                               Width="20" Height="20" />
                                            <TextBlock Text="{Binding Current3DIssueCounterText}" Foreground="#A0A8B8"
                                                       VerticalAlignment="Center" FontWeight="Bold" FontSize="11.5" />
                                            <TextBlock Text="{Binding Current3DIssueSummary}" Foreground="#F0F6FC"
                                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" />
                                            <Button Command="{Binding GoToPrevious3DIssueCommand}"
                                                    Padding="4,2"
                                                    ToolTip.Tip="Go to previous 3D issue [ Ctrl + Shift + Down ]">
                                                <icon:MaterialIcon Kind="ChevronLeft" Width="16" Height="16" />
                                            </Button>
                                            <Button Command="{Binding GoToNext3DIssueCommand}"
                                                    Padding="4,2"
                                                    ToolTip.Tip="Go to next 3D issue [ Ctrl + Shift + Up ]">
                                                <icon:MaterialIcon Kind="ChevronRight" Width="16" Height="16" />
                                            </Button>
                                            <Button Command="{Binding RepairCurrent3DIssueSolidifyCommand}"
                                                    IsVisible="{Binding CanRepairCurrent3DIssue}"
                                                    Padding="6,2"
                                                    ToolTip.Tip="Solidify cavity / fill suction cup">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <icon:MaterialIcon Kind="Cube" Width="14" Height="14"
                                                                       Foreground="#00D2FF" />
                                                    <TextBlock Text="Solidify" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding RepairCurrent3DIssueDrillCommand}"
                                                    IsVisible="{Binding CanRepairCurrent3DIssue}"
                                                    Padding="6,2"
                                                    ToolTip.Tip="Drill drain hole into cavity">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <icon:MaterialIcon Kind="Wrench" Width="14" Height="14"
                                                                       Foreground="#FF9800" />
                                                    <TextBlock Text="Drill Drain" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Top-Right Overlays: Out-of-bounds Warning & Resin Drainage Legend -->
                                    <StackPanel HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="14,148,14,0"
                                                Spacing="8"
                                                IsHitTestVisible="False">
                                        <!-- Out-of-bounds Build Volume Warning Overlay -->
                                        <Border Padding="10,6"
                                                Background="#E0301014"
                                                BorderBrush="#FF2040"
                                                BorderThickness="1.5"
                                                CornerRadius="6">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="HasLayer3DMesh" />
                                                    <Binding Path="#LayerModel3DView.IsOutOfBounds" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <icon:MaterialIcon Kind="AlertDecagram"
                                                                   Width="22"
                                                                   Height="22"
                                                                   Foreground="#FF3355"
                                                                   VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FFA0B0"
                                                               Text="OUT OF BOUNDS WARNING" />
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               Text="{Binding #LayerModel3DView.OutOfBoundsWarningText}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Peel Force & Cross-Section Risk Legend HUD -->
                                        <Border Padding="14,10"
                                                Background="#E8161B22"
                                                BorderBrush="#FF5252"
                                                BorderThickness="1.5"
                                                CornerRadius="8"
                                                BoxShadow="0 4 16 0 #70000000">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="HasLayer3DMesh" />
                                                    <Binding Path="#LayerModel3DView.IsPeelRiskActive" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <StackPanel Spacing="8" Width="280">
                                                <DockPanel>
                                                    <icon:MaterialIcon Kind="ChartAreaspline" Foreground="#FF5252" Width="20"
                                                                       Height="20" VerticalAlignment="Center"
                                                                       Margin="0,0,8,0" />
                                                    <TextBlock Text="Peel Force &amp; Area Risk" FontSize="12.5"
                                                               FontWeight="Bold" Foreground="#F0F6FC"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                                <StackPanel Spacing="5">
                                                    <DockPanel>
                                                        <Border Width="14" Height="14" Background="#FF1455"
                                                                CornerRadius="3" Margin="0,0,8,0"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="Critical Peel Spike (ΔArea ≥ 35%)" FontSize="11.5"
                                                                   FontWeight="Bold" Foreground="#FF7B90"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <Border Width="14" Height="14" Background="#E65100"
                                                                CornerRadius="3" Margin="0,0,8,0"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="High Peel Area (&gt; 80% peak)" FontSize="11.5"
                                                                   FontWeight="SemiBold" Foreground="#E6EDF3"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <Border Width="14" Height="14" Background="#FFC107"
                                                                CornerRadius="3" Margin="0,0,8,0"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="Moderate Load (55%–80% peak)" FontSize="11.5"
                                                                   FontWeight="SemiBold" Foreground="#E6EDF3"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <Border Width="14" Height="14" Background="#19D74B"
                                                                CornerRadius="3" Margin="0,0,8,0"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="Stable Cross-Section (25%–55%)" FontSize="11.5"
                                                                   FontWeight="SemiBold" Foreground="#E6EDF3"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <Border Width="14" Height="14" Background="#235AE1"
                                                                CornerRadius="3" Margin="0,0,8,0"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="Minimal Peel Force (&lt; 25% peak)" FontSize="11.5"
                                                                   FontWeight="SemiBold" Foreground="#E6EDF3"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </StackPanel>
                                                <TextBlock
                                                    Text="⚠️ Sudden cross-section spikes cause layer lines or support separation."
                                                    FontSize="11"
                                                    Foreground="#A0A8B8"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Bed Adhesion Footprint Legend HUD -->
                                        <Border Padding="14,10"
                                                Background="#E8161B22"
                                                BorderBrush="#00E676"
                                                BorderThickness="1.5"
                                                CornerRadius="8"
                                                BoxShadow="0 4 16 0 #70000000">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="HasLayer3DMesh" />
                                                    <Binding Path="#LayerModel3DView.IsBedAdhesionActive" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <StackPanel Spacing="8" Width="280">
                                                <DockPanel>
                                                    <icon:MaterialIcon Kind="LayersOutline" Foreground="#00E676" Width="20"
                                                                       Height="20" VerticalAlignment="Center"
                                                                       Margin="0,0,8,0" />
                                                    <TextBlock Text="Bed Contact &amp; Adhesion" FontSize="12.5"
                                                               FontWeight="Bold" Foreground="#F0F6FC"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                                <StackPanel Spacing="5">
                                                    <DockPanel>
                                                        <Border Width="14" Height="14" Background="#00E676"
                                                                CornerRadius="3" Margin="0,0,8,0"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="Direct Plate Contact (Z = 0)" FontSize="11.5"
                                                                   FontWeight="Bold" Foreground="#00E676"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <Border Width="14" Height="14" Background="#2E52A6"
                                                                CornerRadius="3" Margin="0,0,8,0"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="Bottom Exposure Zone" FontSize="11.5"
                                                                   FontWeight="SemiBold" Foreground="#E6EDF3"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <Border Width="14" Height="14" Background="#3399A6"
                                                                CornerRadius="3" Margin="0,0,8,0"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="Transition Exposure Zone" FontSize="11.5"
                                                                   FontWeight="SemiBold" Foreground="#E6EDF3"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <Border Width="14" Height="14" Background="#FF4119"
                                                                CornerRadius="3" Margin="0,0,8,0"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="Unsupported Low Overhang (&lt; 3mm)" FontSize="11.5"
                                                                   FontWeight="SemiBold" Foreground="#FF8A80"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </StackPanel>
                                                <TextBlock
                                                    Text="{Binding #LayerModel3DView.BedAdhesionText}"
                                                    FontSize="11.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="#F0F6FC"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Cross-Section Area & Peel Force HUD Overlay -->
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="14,0,14,36"
                                            Width="450"
                                            Height="210"
                                            Background="#E80D1117"
                                            BorderBrush="#00D2FF"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            BoxShadow="0 4 16 0 #70000000"
                                            ClipToBounds="True"
                                            IsVisible="{Binding #LayerModel3DView.ShowPeelCurve}">
                                        <Grid RowDefinitions="Auto,*">
                                            <Grid Grid.Row="0" Margin="10,8,8,4" ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            VerticalAlignment="Center">
                                                    <icon:MaterialIcon Kind="ChartAreaspline" Foreground="#00D2FF"
                                                                       Width="18" Height="18"
                                                                       VerticalAlignment="Center" />
                                                    <TextBlock Text="Peel Force &amp; Cross-Section" FontSize="13"
                                                               FontWeight="Bold" Foreground="#F0F6FC"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Padding="4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding TogglePeelCurveCommand}"
                                                        ToolTip.Tip="Close Peel Force Curve [A]">
                                                    <icon:MaterialIcon Kind="Close" Width="16" Height="16"
                                                                       Foreground="#8B949E" />
                                                </Button>
                                            </Grid>
                                            <controls:LayerAreaPeelCurveControl Grid.Row="1"
                                                    Margin="6,0,6,6"
                                                    LayerAreas="{Binding LayerAreas}"
                                                    PeelSpikes="{Binding PeelSpikes}"
                                                    LayerLiftSpeeds="{Binding LayerLiftSpeeds}"
                                                    LayerLiftSpeeds2="{Binding LayerLiftSpeeds2}"
                                                    LayerLiftHeights="{Binding LayerLiftHeights}"
                                                    LayerLiftHeights2="{Binding LayerLiftHeights2}"
                                                    CurrentLayer="{Binding ActualLayer}"
                                                    MaxArea="{Binding MaxLayerArea}"
                                                    PeakLayer="{Binding PeakLayerIndex}"
                                                    HaveTiltingVat="{Binding SlicerFile.HaveTiltingVat}"
                                                    LayerSelectedCommand="{Binding SelectLayerCommand}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Bottom Horizontal Cutaway & Cross-Section Control Bar -->
                            <suki:GlassCard Grid.Row="2"
                                            Margin="0,2,0,0"
                                            Padding="8,4"
                                            IsEnabled="{Binding HasLayer3DMesh}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8"
                                      VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <icon:MaterialIcon Kind="ContentCut" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Cutaway:" FontWeight="SemiBold" FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ComboBox Grid.Column="1"
                                              Width="140"
                                              Height="28"
                                              ItemsSource="{Binding Settings.Layer3DPreview.CutawayAxis, Converter={StaticResource EnumToCollectionConverter}, Mode=OneTime}"
                                              SelectedItem="{Binding Settings.Layer3DPreview.CutawayAxis, Converter={StaticResource FromValueDescriptionToEnumConverter}}"
                                              ToolTip.Tip="Cutaway plane axis: Off, X-axis, or Y-axis" />

                                    <Slider Grid.Column="2"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding IsCutawayActive}"
                                            Minimum="{Binding #LayerModel3DView.CutawayMin}"
                                            Maximum="{Binding #LayerModel3DView.CutawayMax}"
                                            Value="{Binding Settings.Layer3DPreview.CutawayPosition, Mode=TwoWay}"
                                            SmallChange="0.5"
                                            LargeChange="5"
                                            ToolTip.Tip="Cutaway plane position along selected axis" />

                                    <TextBlock Grid.Column="3"
                                               Width="70"
                                               TextAlignment="Right"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               IsEnabled="{Binding IsCutawayActive}"
                                               Text="{Binding #LayerModel3DView.CutawayPosition, StringFormat='{}{0:F1} mm'}" />

                                    <ToggleButton Grid.Column="4"
                                                  Height="28"
                                                  Padding="6,2"
                                                  IsEnabled="{Binding IsCutawayActive}"
                                                  IsChecked="{Binding Settings.Layer3DPreview.CutawayInvert, Mode=TwoWay}"
                                                  ToolTip.Tip="Invert cut direction">
                                        <icon:MaterialIcon Kind="SwapHorizontal" Width="16" Height="16" />
                                    </ToggleButton>

                                    <Button Grid.Column="5"
                                            Height="28"
                                            Padding="6,2"
                                            IsEnabled="{Binding IsCutawayActive}"
                                            Command="{Binding ResetCutawayPositionCommand}"
                                            ToolTip.Tip="Reset cutaway position to model center">
                                        <icon:MaterialIcon Kind="ImageFilterCenterFocus" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </suki:GlassCard>

                            <TextBlock Grid.Row="3"
                                       Margin="5"
                                       HorizontalAlignment="Center"
                                       Text="{Binding Layer3DStatus}"
                                       TextAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </suki:GlassCard>


        </DockPanel>

        <!--  Progress overlay !  -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              ColumnDefinitions="*,Auto,*"
              IsEnabled="{Binding IsProgressVisible}"
              IsVisible="{Binding IsProgressVisible}"
              RowDefinitions="*,Auto,*">
            <suki:GlassCard Name="ProgressBorder"
                            Grid.Row="1"
                            Grid.Column="1"
                            IsOpaque="True"
                            MinWidth="450">
                <Grid Name="ProgressGrid"
                      ColumnDefinitions="*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="10">

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="10">
                        <icon:MaterialIcon Kind="Cog" />
                        <TextBlock Text="{Binding Progress.Title}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="10">
                        <icon:MaterialIcon Kind="Timer" />
                        <TextBlock Text="{Binding Progress.ElapsedTimeString, StringFormat=Elapsed Time: {0}}" />
                        <TextBlock IsVisible="{Binding Progress.IsPaused}"
                                   Text="[PAUSED]" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Text="{Binding Progress.Description}" />

                    <Grid Grid.Row="3"
                          ColumnDefinitions="*,Auto,Auto"
                          RowDefinitions="Auto"
                          ColumnSpacing="5">
                        <ProgressBar Grid.Column="0"
                                     VerticalAlignment="Stretch"
                                     IsIndeterminate="{Binding Progress.IsIndeterminate}"
                                     Maximum="100"
                                     Minimum="0"
                                     Margin="0,0,10,0"
                                     ShowProgressText="True"
                                     Value="{Binding Progress.ProgressPercent}" />
                        <ToggleButton Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Content="{icon:MaterialIconExt PlayPause}"
                                      IsChecked="{Binding Progress.IsPaused}"
                                      IsDefault="True"
                                      IsEnabled="{Binding Progress.CanCancel}" />
                        <Button Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{Binding ProgressOnClickCancelCommand}"
                                Content="{icon:MaterialIconTextExt Kind=StopCircleOutline, Text='Cancel'}"
                                IsCancel="True"
                                IsEnabled="{Binding Progress.CanCancel}" />
                    </Grid>

                    <TextBox Grid.Row="4"
                             MaxWidth="{Binding #ProgressGrid.Bounds.Width}"
                             MaxHeight="400"
                             Padding="10"
                             Classes="ReadOnlyMultiLineWrap"
                             IsVisible="{Binding Progress.Log, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             Text="{Binding Progress.Log}" />

                </Grid>
            </suki:GlassCard>
        </Grid>
    </Grid>
</windows:GenericWindow>
