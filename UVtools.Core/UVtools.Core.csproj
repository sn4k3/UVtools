<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(UVtoolsVersion)</Version>

    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile>..\documentation\$(AssemblyName).xml</DocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <NoWarn>1701;1702;1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Voxel\MarchingCubesTable.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Voxel\MarchingCubesTable.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNext" Version="6.10.0" />
    <PackageReference Include="EmguExtensions" Version="0.3.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageReference Include="NativeCompressions" Version="1.2.0" />
    <PackageReference Include="StageKit" Version="0.4.1" />
    <PackageReference Include="System.Reflection.TypeExtensions" Version="4.7.0" />
    <PackageReference Include="CommunityToolkit.Diagnostics" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageReference Include="BinarySerializer" Version="10.1.0" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="Emgu.CV" Version="$(EmguCvVersion)" />
    <PackageReference
      Include="Emgu.CV.runtime.mini.windows"
      Version="$(EmguCvVersion)"
      ExcludeAssets="build;buildTransitive"
    />
    <PackageReference
      Include="Emgu.CV.runtime.mini.ubuntu-24.04-x64"
      Version="$(EmguCvVersion)"
      GeneratePathProperty="true"
    />
    <PackageReference
      Include="Emgu.CV.runtime.mini.debian-trixie-arm64"
      Version="$(EmguCvVersion)"
    />
    <PackageReference Include="Emgu.CV.runtime.mini.macos" Version="$(EmguCvVersion)" />
    <PackageReference Include="KdTree" Version="1.4.1" />
    <PackageReference Include="ZLinq" Version="1.5.6" />
  </ItemGroup>

  <!-- Keep UVtools' linux-x64 release name while using the Ubuntu 24.04 native binary.
           NuGet cannot select an ubuntu-x64 asset for a portable linux-x64 RID.
           The alias also lets RID-less builds load it through .NET's portable Linux probe. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64'">
    <None
      Include="$(PkgEmgu_CV_runtime_mini_ubuntu-24_04-x64)/runtimes/ubuntu-x64/native/libcvextern.so"
      Link="runtimes/linux-x64/native/libcvextern.so"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      Visible="false"
      Condition="'$(RuntimeIdentifier)' == ''"
    />
    <None
      Include="$(PkgEmgu_CV_runtime_mini_ubuntu-24_04-x64)/runtimes/ubuntu-x64/native/libcvextern.so"
      Link="libcvextern.so"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      Visible="false"
      Condition="'$(RuntimeIdentifier)' == 'linux-x64'"
    />
  </ItemGroup>

  <Target
    Name="PreparePackageReleaseNotesFromFile"
    BeforeTargets="GenerateNuspec"
    Condition="Exists('..\RELEASE_NOTES.md')"
  >
    <ReadLinesFromFile File="..\RELEASE_NOTES.md">
      <Output TaskParameter="Lines" ItemName="ReleaseNoteLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <PackageReleaseNotes>@(ReleaseNoteLines, '%0a')</PackageReleaseNotes>
    </PropertyGroup>
  </Target>
</Project>
